---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Faq from '../../components/Faq.astro';
import { buildHelpSearchIndex } from '../../lib/search/help-index';
import { fetchAllPublicBlogPosts } from '../../lib/api/blog.api';

type ResourceCard = {
  title: string;
  body: string;
  href: string;
  icon: string;
  tall?: boolean;
};

type ResourceSection = {
  heading: string;
  cards: ResourceCard[];
  cols: 1 | 2 | 3;
};

const sections: ResourceSection[] = [
  {
    heading: 'For Users',
    cols: 3,
    cards: [
      {
        title: 'Knowledge Base',
        body: 'Get knowledge of the features, their usage, and implementation.',
        href: '/resources/knowledge-base',
        icon: '/images/resources/icon-knowledge-base.svg',
      },
      {
        title: 'FAQs',
        body: 'Browse through our FAQs and find information that helps you to quickly resolve most common problems.',
        href: '#help-faq',
        icon: '/images/resources/icon-faqs.svg',
        tall: true,
      },
      {
        title: 'Community',
        body: 'Connect with community for your questions answered and share tips with other users',
        href: '#',
        icon: '/images/resources/icon-community.svg',
      },
    ],
  },
  {
    heading: 'For Developers',
    cols: 2,
    cards: [
      {
        title: 'API Guide',
        body: 'Understand and integrate PixelDesk service with third-party applications using API.',
        href: '#',
        icon: '/images/resources/icon-api.svg',
      },
      {
        title: 'Extension Guide',
        body: 'Browse through our FAQs and find information that helps you to quickly resolve most common problems.',
        href: '#',
        icon: '/images/resources/icon-extension.svg',
        tall: true,
      },
    ],
  },
  {
    heading: 'Learning',
    cols: 1,
    cards: [
      {
        title: 'Video Tutorials',
        body: 'Watch our videos to get started with PixelDesk. Find the best tips and tricks for some of our most important features.',
        href: '#',
        icon: '/images/resources/icon-video.svg',
        tall: true,
      },
    ],
  },
  {
    heading: 'Updates',
    cols: 2,
    cards: [
      {
        title: "What's New",
        body: 'Get the latest news on product updates and enhancements from the PixelDesk.',
        href: '#',
        icon: '/images/resources/icon-whats-new.svg',
      },
      {
        title: 'Blogs',
        body: 'Read insightful articles by the PixelDesk team as they discuss a wide range of topics, from product news to project management.',
        href: '/blogs',
        icon: '/images/resources/icon-blogs.svg',
        tall: true,
      },
    ],
  },
];

const gridClass = {
  1: 'resources-grid--1',
  2: 'resources-grid--2',
  3: 'resources-grid--3',
} as const;

const helpFaqs = [
  {
    q: 'How do I get started with Pixeldesk?',
    a: 'Create a free workspace, invite your team, and add your first project. Follow the step-by-step guide at /resources/guides/set-up-your-workspace for a full walkthrough.',
  },
  {
    q: 'How do I set up a client portal?',
    a: 'Open project settings, enable the client portal, and invite your client by email. See /resources/guides/set-up-client-portal for visibility and approval settings.',
  },
  {
    q: 'How do I create a sprint in Pixeldesk?',
    a: 'Go to Sprint Planning in your project, create a sprint with dates, drag tasks from the backlog, and click Start Sprint. Full instructions are in /resources/guides/create-your-first-sprint.',
  },
  {
    q: 'Is Pixeldesk free to use?',
    a: 'Yes. The Starter plan is free for up to 5 users and 3 active projects. Growth adds client portal, sprints, chat, and budget tracking — see /pricing for details.',
  },
  {
    q: 'Where can I read project management guides?',
    a: 'Visit /blogs for SEO guides on client portals, sprint planning, timesheets, and more — each with FAQs and links to features and pricing.',
  },
];

let blogPostsForSearch: Awaited<ReturnType<typeof fetchAllPublicBlogPosts>> = [];
try {
  blogPostsForSearch = await fetchAllPublicBlogPosts();
} catch {
  /* help search works without blogs */
}

const allCards = sections.flatMap((section) => section.cards);
const searchIndex = buildHelpSearchIndex(allCards, helpFaqs, blogPostsForSearch);
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout
  title="Pixeldesk Help Center — Guides, Tutorials & FAQs"
  description="Find answers fast with the Pixeldesk Help Center. Setup guides, feature tutorials, FAQ, troubleshooting, and best practices for project management, client portals, sprint planning, and team management."
  canonicalPath="/resources"
  topBg="rect-11"
>
  <Header current="resources" />
  <main class="resources-page">
    <section class="resources-hero relative overflow-hidden pt-[338.75px] pb-[101.25px]">
      <div class="pd-rail relative text-center">
        <h1 class="resources-hero__title">How can we help?</h1>
        <p class="resources-hero__subtitle">
          Find step-by-step guides, feature tutorials, and answers to common questions — all in one place.
        </p>

        <form class="resources-search mx-auto mt-[42.5px] w-full max-w-[702.5px]" role="search" action="/resources" method="get">
          <label class="sr-only" for="resource-search">Search resources</label>
          <div class="resources-search__field">
            <input
              id="resource-search"
              name="q"
              type="search"
              value={initialQuery}
              placeholder="Search for features, guides, or questions…"
              class="resources-search__input"
              autocomplete="off"
            />
            <span class="resources-search__icon" aria-hidden="true">
              <img src="/images/resources/icon-search.svg" alt="" />
            </span>
          </div>
        </form>
      </div>
    </section>

    <section
      class="resources-search-results pd-rail"
      id="resources-search-results"
      hidden
      aria-live="polite"
      aria-label="Search results"
    >
      <h2 class="resources-search-results__heading">Search results</h2>
      <ul class="resources-search-results__list" id="resources-search-list"></ul>
      <p class="resources-search-results__empty" id="resources-search-empty" hidden>
        No results found. Try different keywords or browse the sections below.
      </p>
    </section>

    <section class="resources-cards pb-[285px]" id="resources-main">
      <div class="pd-rail resources-sections">
        {
          sections.map((section) => (
            <div class="resources-section">
              <h2 class="resources-section__heading">{section.heading}</h2>
              <div class:list={['resources-grid', gridClass[section.cols]]}>
                {section.cards.map((card) => (
                  <a href={card.href} class:list={['resources-card', card.tall && 'resources-card--tall']}>
                    <span class="resources-card__icon">
                      <span class="resources-card__icon-glow" aria-hidden="true">
                        <img src={card.icon} alt="" />
                      </span>
                    </span>
                    <h3 class="resources-card__title">{card.title}</h3>
                    <p class="resources-card__body">{card.body}</p>
                    <span class="resources-card__chip">Learn More</span>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <Faq items={helpFaqs} title="Help center, explained." layout="centered" />
  </main>
  <Footer />
</BaseLayout>

<style>
  .resources-hero__title {
    max-width: 888.75px;
    margin-inline: auto;
    font-size: 62.5px;
    font-weight: 500;
    line-height: 65px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .resources-hero__subtitle {
    margin: 17.5px auto 0;
    max-width: 892.5px;
    font-size: 20px;
    font-weight: 300;
    line-height: 30px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .resources-search__field {
    position: relative;
    height: 52.5px;
    border-radius: 26.25px;
    background: #fff;
    /* Figma Group 701 filter: dx/dy 6, blur 16.5, #6c41ff @ 21% (×1.25) */
    box-shadow: 7.5px 7.5px 41.25px rgba(108, 65, 255, 0.21);
  }

  .resources-search__input {
    box-sizing: border-box;
    width: 100%;
    height: 52.5px;
    padding: 0 56.25px 0 25px;
    border: 0;
    border-radius: 26.25px;
    background: transparent;
    font-size: 17.5px;
    font-weight: 300;
    line-height: 52.5px;
    color: #000945;
    outline: none;
  }

  .resources-search__input::placeholder {
    color: #878787;
  }

  .resources-search__icon {
    position: absolute;
    top: 50%;
    right: 26.25px;
    display: flex;
    width: 22.5px;
    height: 22.5px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .resources-search__icon img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .resources-search-results {
    padding-bottom: 40px;
  }

  .resources-search-results__heading {
    margin: 0 0 20px;
    padding-left: calc(65px * var(--pd-scale, 1.25));
    font-size: 25px;
    font-weight: 500;
    line-height: 30px;
    color: #000945;
  }

  .resources-search-results__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0 calc(65px * var(--pd-scale, 1.25));
    list-style: none;
  }

  .resources-search-results__item a {
    display: block;
    padding: 16px 20px;
    border: 1px solid #e2e2e2;
    border-radius: 12px;
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .resources-search-results__item a:hover {
    border-color: rgba(108, 65, 255, 0.35);
    box-shadow: 0 6px 20px rgba(108, 65, 255, 0.1);
  }

  .resources-search-results__type {
    display: inline-block;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: #6c41ff;
  }

  .resources-search-results__title {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    color: #000945;
  }

  .resources-search-results__excerpt {
    margin: 6px 0 0;
    font-size: 14px;
    font-weight: 300;
    line-height: 20px;
    color: #444;
  }

  .resources-search-results__empty {
    margin: 0;
    padding-left: calc(65px * var(--pd-scale, 1.25));
    font-size: 16px;
    font-weight: 300;
    color: #878787;
  }

  .resources-sections {
    display: flex;
    flex-direction: column;
    gap: 62.5px;
  }

  .resources-section {
    padding-left: calc(65px * var(--pd-scale, 1.25));
  }

  .resources-section__heading {
    font-size: 25px;
    font-weight: 500;
    line-height: 30px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  /* Figma: 278×222 cards, 28px gaps — fixed tracks, left-aligned (not 1fr stretch) */
  .resources-grid {
    display: grid;
    gap: calc(28px * var(--pd-scale, 1.25));
    width: 100%;
    margin-top: calc(10px * var(--pd-scale, 1.25));
    justify-content: start;
  }

  .resources-grid--3 {
    grid-template-columns: repeat(3, calc(278px * var(--pd-scale, 1.25)));
  }

  .resources-grid--2 {
    grid-template-columns: repeat(2, calc(278px * var(--pd-scale, 1.25)));
  }

  .resources-grid--1 {
    grid-template-columns: calc(278px * var(--pd-scale, 1.25));
  }

  .resources-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: calc(15px * var(--pd-scale, 1.25));
    width: 100%;
    height: calc(222px * var(--pd-scale, 1.25));
    padding: calc(20px * var(--pd-scale, 1.25));
    border: calc(1px * var(--pd-scale, 1.25)) solid #e2e2e2;
    border-radius: calc(15px * var(--pd-scale, 1.25));
    background: #fff;
    box-shadow: none;
    text-decoration: none;
    color: inherit;
  }

  .resources-card--tall {
    height: auto;
    min-height: calc(222px * var(--pd-scale, 1.25));
  }

  /* Figma Group 688 — 41px layout slot; 69px asset bleeds via inset -34.15% wrapper (×1.25) */
  .resources-card__icon {
    position: relative;
    flex-shrink: 0;
    width: 51.25px;
    height: 51.25px;
  }

  .resources-card__icon-glow {
    position: absolute;
    inset: -34.15%;
  }

  .resources-card__icon-glow img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .resources-card__title {
    font-size: 25px;
    font-weight: 500;
    line-height: 30px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .resources-card__body {
    flex: 1;
    font-size: 15px;
    font-weight: 300;
    line-height: 22.5px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .resources-card__chip {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    height: 22.5px;
    padding: 0 12.5px;
    border-radius: 50px;
    background: rgba(108, 65, 255, 0.11);
    color: #6c41ff;
    font-size: 11.25px;
    font-weight: 600;
    line-height: 17.5px;
    letter-spacing: 0;
    text-shadow: none;
  }

  .sr-only {
    position: absolute;
    width: 1.25px;
    height: 1.25px;
    padding: 0;
    margin: -1.25px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1199px) {
    .resources-section {
      padding-left: 0;
    }

    .resources-search-results__heading,
    .resources-search-results__list,
    .resources-search-results__empty {
      padding-left: 0;
    }

    .resources-grid--3 {
      grid-template-columns: repeat(2, calc(278px * var(--pd-scale, 1.25)));
    }
  }

  @media (max-width: 767px) {
    .resources-hero {
      padding-top: 250px;
      padding-bottom: 80px;
    }

    .resources-hero__title {
      font-size: 50px;
      line-height: 52px;
    }

    .resources-hero__subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .resources-grid--3,
    .resources-grid--2,
    .resources-grid--1 {
      grid-template-columns: minmax(0, 1fr);
    }

    .resources-card {
      width: 100%;
    }

    .resources-cards {
      padding-bottom: 120px;
    }
  }
</style>

<script define:vars={{ searchIndex, initialQuery }}>
  function normalizeSearchQuery(value) {
    return value
      .trim()
      .toLowerCase()
      .replace(/[^\w\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function matchesSearchQuery(query, ...fields) {
    const normalized = normalizeSearchQuery(query);
    if (!normalized) return true;
    const haystack = fields.map((field) => normalizeSearchQuery(field)).join(' ');
    return normalized.split(' ').every((term) => haystack.includes(term));
  }

  const searchInput = document.getElementById('resource-search');
  const resultsPanel = document.getElementById('resources-search-results');
  const resultsList = document.getElementById('resources-search-list');
  const emptyState = document.getElementById('resources-search-empty');
  const mainSection = document.getElementById('resources-main');
  const searchForm = searchInput?.closest('form');

  function renderResults(query) {
    if (!resultsPanel || !resultsList || !emptyState || !mainSection) return;

    const trimmed = query.trim();
    if (!trimmed) {
      resultsPanel.hidden = true;
      mainSection.hidden = false;
      resultsList.replaceChildren();
      emptyState.hidden = true;
      return;
    }

    const matches = searchIndex.filter((item) =>
      matchesSearchQuery(trimmed, item.title, item.excerpt, item.type),
    );

    resultsPanel.hidden = false;
    mainSection.hidden = matches.length > 0;
    emptyState.hidden = matches.length > 0;
    resultsList.replaceChildren();

    matches.slice(0, 12).forEach((item) => {
      const li = document.createElement('li');
      li.className = 'resources-search-results__item';
      li.innerHTML = `
        <a href="${item.href}">
          <span class="resources-search-results__type">${item.type}</span>
          <p class="resources-search-results__title">${item.title}</p>
          <p class="resources-search-results__excerpt">${item.excerpt}</p>
        </a>
      `;
      resultsList.appendChild(li);
    });

    if (matches.length === 0) {
      mainSection.hidden = false;
    }
  }

  searchInput?.addEventListener('input', () => {
    renderResults(searchInput.value);
    const url = new URL(window.location.href);
    const value = searchInput.value.trim();
    if (value) url.searchParams.set('q', value);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
  });

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    renderResults(searchInput?.value ?? '');
  });

  if (initialQuery) {
    renderResults(initialQuery);
  }
</script>
