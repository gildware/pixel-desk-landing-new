---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { fetchPublicVideoTutorials } from '../../lib/api/video-tutorials.api';
import {
  buildVideoTutorialsViewModel,
  fallbackDefaultVideoLessonId,
  fallbackVideoTutorialCategories,
  findVideoLesson,
  type VideoTutorialCategory,
} from '../../data/video-tutorials';

let videoTutorialCategories: VideoTutorialCategory[] = fallbackVideoTutorialCategories;
let defaultVideoLessonId = fallbackDefaultVideoLessonId;

try {
  const payload = await fetchPublicVideoTutorials();
  const viewModel = buildVideoTutorialsViewModel(payload);
  videoTutorialCategories = viewModel.categories;
  defaultVideoLessonId = viewModel.defaultLessonId;
} catch (error) {
  console.warn('[video-tutorials] Failed to load from API:', error);
}

const initial = findVideoLesson(videoTutorialCategories, defaultVideoLessonId) ??
  findVideoLesson(videoTutorialCategories, videoTutorialCategories.flatMap((c) => c.lessons)[0]?.id ?? '') ?? {
    category: videoTutorialCategories[0],
    lesson: videoTutorialCategories[0]?.lessons[0] ?? {
      id: defaultVideoLessonId,
      title: 'Sub Category',
      duration: '3.30 minute',
      description: [],
      videoUrl: null,
      categoryTitle: 'Category',
    },
  };

const clientCategories = videoTutorialCategories.map((category) => ({
  id: category.id,
  title: category.title,
  lessons: category.lessons,
}));

const allLessons = videoTutorialCategories.flatMap((category) =>
  category.lessons.map((lesson) => ({ category, lesson })),
);
const defaultLessonIndex = Math.max(
  0,
  allLessons.findIndex((entry) => entry.lesson.id === defaultVideoLessonId),
);
const lessonOrder = allLessons.map((entry) => entry.lesson.id);

const ICON = '/images/video-tutorials/icon-category.svg';
const ICON_OPEN = '/images/video-tutorials/icon-category-open.svg';
const ICON_ALT = '/images/video-tutorials/icon-category-alt.svg';
const ICON_SUB = '/images/video-tutorials/icon-subcategory.svg';
const CHEVRON_RIGHT = '/images/video-tutorials/chevron-right.svg';
const CHEVRON_DOWN = '/images/video-tutorials/chevron-down.svg';
---

<BaseLayout
  title="Pixeldesk Video Tutorials — Learn the Platform"
  description="Watch Pixeldesk video tutorials to learn workspace setup, projects, client portals, and team workflows step by step."
  canonicalPath="/resources/video-tutorials"
  topBg="rect-11"
>
  <Header current="resources" />
  <main
    class="vt-page"
    id="vt-page"
    data-default-lesson-id={defaultVideoLessonId}
    data-categories={JSON.stringify(clientCategories)}
    data-lesson-order={JSON.stringify(lessonOrder)}
    data-default-lesson-index={defaultLessonIndex}
  >
    <section class="vt-hero relative overflow-hidden">
      <div class="pd-rail vt-hero__inner text-center">
        <p class="vt-hero__badge">Video Tutorials</p>
        <h1 class="vt-hero__title">Learn. Understand. Enjoy Pixeldesk</h1>
        <p class="vt-hero__subtitle">E risus a ligula porta, cursus faucibus dui cursus. Maecenas aliquam mauris in pulvinar luctus. Nam eleifend augue in lectus cursus laoreet.</p>
      </div>
    </section>

    <section class="vt-body">
      <div class="pd-rail vt-body__grid">
        <aside class="vt-sidebar" aria-label="Video categories">
          <div class="vt-sidebar__scroll" data-vt-sidebar-scroll>
          {
            videoTutorialCategories.map((category) => {
              const hasLessons = category.lessons.length > 0;
              const panelId = `vt-panel-${category.id}`;
              const isOpen = category.lessons.some((lesson) => lesson.id === defaultVideoLessonId);
              const isFlatCategory =
                hasLessons && category.lessons.length === 1 && Boolean(category.durationLabel);
              const flatLesson = isFlatCategory ? category.lessons[0] : null;

              if (isFlatCategory && flatLesson) {
                return (
                  <div
                    class:list={[
                      'vt-cat',
                      'vt-cat--flat',
                      flatLesson.id === defaultVideoLessonId && 'vt-cat--flat-active',
                    ]}
                  >
                    <div class="vt-cat__inner vt-cat__inner--flat">
                      <button
                        type="button"
                        class="vt-cat__flat-btn"
                        data-lesson-id={flatLesson.id}
                        data-video-url={flatLesson.videoUrl ?? undefined}
                        data-category-title={category.title}
                        aria-current={flatLesson.id === defaultVideoLessonId ? 'true' : undefined}
                      >
                        <span class="vt-cat__label">
                          <img src={ICON_ALT} alt="" width="12" height="12" />
                          <span>{category.title}</span>
                        </span>
                        <span class="vt-cat__duration">{category.durationLabel}</span>
                      </button>
                    </div>
                  </div>
                );
              }

              if (!hasLessons) {
                return (
                  <div class="vt-cat vt-cat--flat">
                    <div class="vt-cat__row">
                      <span class="vt-cat__label">
                        <img src={category.durationLabel ? ICON_ALT : ICON} alt="" width="12" height="12" />
                        <span>{category.title}</span>
                      </span>
                      {category.durationLabel ? (
                        <span class="vt-cat__duration">{category.durationLabel}</span>
                      ) : (
                        <img class="vt-cat__chevron vt-cat__chevron--collapsed" src={CHEVRON_RIGHT} alt="" width="10" height="6" />
                      )}
                    </div>
                  </div>
                );
              }

              return (
                <div
                  class:list={['vt-cat', 'vt-cat--accordion', isOpen && 'vt-cat--open']}
                  data-lessons={category.lessons.length}
                >
                  <div class="vt-cat__inner">
                    <button
                      type="button"
                      class="vt-cat__toggle"
                      aria-expanded={isOpen}
                      aria-controls={panelId}
                    >
                      <span class="vt-cat__label">
                        <img class="vt-cat__icon" src={isOpen ? ICON_OPEN : ICON} alt="" width="12" height="12" data-icon-collapsed={ICON} data-icon-open={ICON_OPEN} />
                        <span>{category.title}</span>
                      </span>
                      {!isOpen && category.durationLabel ? (
                        <span class="vt-cat__duration">{category.durationLabel}</span>
                      ) : (
                        <img
                          class:list={['vt-cat__chevron', !isOpen && 'vt-cat__chevron--collapsed']}
                          src={isOpen ? CHEVRON_DOWN : CHEVRON_RIGHT}
                          alt=""
                          width="10"
                          height="6"
                        />
                      )}
                    </button>
                    <div class="vt-cat__panel" id={panelId} hidden={!isOpen}>
                      <div class="vt-cat__divider vt-cat__divider--wide" aria-hidden="true"></div>
                      {category.lessons.map((lesson, index) => (
                        <div class="vt-sub-block">
                          {index > 0 && (
                            <div class="vt-cat__divider vt-cat__divider--narrow" aria-hidden="true"></div>
                          )}
                          <div class:list={['vt-sub-wrap', lesson.id === defaultVideoLessonId && 'vt-sub-wrap--active']}>
                            <button
                              type="button"
                              class="vt-sub"
                              data-lesson-id={lesson.id}
                              data-video-url={lesson.videoUrl ?? undefined}
                              data-category-title={category.title}
                              aria-current={lesson.id === defaultVideoLessonId ? 'true' : undefined}
                            >
                              <span class="vt-sub__label">
                                <img src={ICON_SUB} alt="" width="12" height="12" />
                                <span>{lesson.title}</span>
                              </span>
                              <span class="vt-sub__duration">{lesson.duration}</span>
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              );
            })
          }
          </div>
        </aside>

        <div class="vt-main">
          <div class="vt-player" aria-label="Video player">
            {
              initial.lesson.videoUrl ? (
                <iframe
                  class="vt-player__iframe"
                  src={initial.lesson.videoUrl}
                  title={initial.lesson.title}
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                />
              ) : (
                <p class="vt-player__label">Video Player</p>
              )
            }
          </div>

          <div class="vt-main__scroll" data-vt-scroll>
            <div class="vt-lessons" data-vt-lessons>
              {
                allLessons.map((entry, index) => (
                  <section
                    class:list={['vt-lesson', index === defaultLessonIndex && 'vt-lesson--active']}
                    data-lesson-id={entry.lesson.id}
                    data-lesson-index={index}
                    hidden={index !== defaultLessonIndex}
                    aria-label={entry.lesson.title}
                  >
                    <div class="vt-copy">
                      <p class="vt-copy__category">{entry.category.title}</p>
                      <p class="vt-copy__sub">{entry.lesson.title}</p>
                      <p class="vt-copy__spacer" aria-hidden="true">&nbsp;</p>
                      <div class="vt-copy__body">
                        {entry.lesson.description.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                      </div>
                    </div>
                  </section>
                ))
              }
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

