<script>
  import { initVideoTutorials } from '../../lib/video-tutorials.client';

  function bootVideoTutorials() {
    const root = document.getElementById('vt-page');
    if (!root) return;

    const defaultLessonId = root.dataset.defaultLessonId ?? '';
    const defaultLessonIndex = Number(root.dataset.defaultLessonIndex ?? '0');
    let categories = [];
    let lessonOrder = [];
    try {
      categories = JSON.parse(root.dataset.categories ?? '[]');
    } catch {
      categories = [];
    }
    try {
      lessonOrder = JSON.parse(root.dataset.lessonOrder ?? '[]');
    } catch {
      lessonOrder = [];
    }

    initVideoTutorials(defaultLessonId, categories, {
      defaultLessonIndex: Number.isFinite(defaultLessonIndex) ? defaultLessonIndex : 0,
      lessonOrder,
    });
  }

  bootVideoTutorials();
  document.addEventListener('astro:page-load', bootVideoTutorials);
</script>
