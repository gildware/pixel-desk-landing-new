---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { topicGuideMap } from '../../data/help-guides';

type Topic = {
  title: string;
  body: string;
  href: string;
  icon: string;
  articles: number;
};

const topics: Topic[] = [
  {
    title: 'Getting Started',
    body: 'Set up your workspace, invite your team, and create your first project.',
    href: `/resources/guides/${topicGuideMap['Getting Started']}`,
    icon: '/images/knowledge-base/icon-getting-started.svg',
    articles: 5,
  },
  {
    title: 'Projects & Tasks',
    body: 'Create tasks, set milestones, manage dependencies, and switch views.',
    href: `/resources/guides/${topicGuideMap['Projects & Tasks']}`,
    icon: '/images/knowledge-base/icon-projects-tasks.svg',
    articles: 4,
  },
  {
    title: 'Sprint Planning',
    body: 'Create sprints, manage your backlog, and track velocity.',
    href: `/resources/guides/${topicGuideMap['Sprint Planning']}`,
    icon: '/images/knowledge-base/icon-sprint-planning.svg',
    articles: 4,
  },
  {
    title: 'Client Portal',
    body: 'Invite clients, manage their access, and configure budget visibility.',
    href: `/resources/guides/${topicGuideMap['Client Portal']}`,
    icon: '/images/knowledge-base/icon-client-portal.svg',
    articles: 6,
  },
  {
    title: 'Notice Board',
    body: 'Post, manage, and archive important team and client announcements.',
    href: `/resources/guides/${topicGuideMap['Notice Board']}`,
    icon: '/images/knowledge-base/icon-notice-board.svg',
    articles: 3,
  },
  {
    title: 'Team Chat',
    body: 'Use project-linked chat, @mentions, file sharing, and search.',
    href: `/resources/guides/${topicGuideMap['Team Chat']}`,
    icon: '/images/knowledge-base/icon-team-chat.svg',
    articles: 3,
  },
  {
    title: 'People Management',
    body: 'Leave requests, holiday calendar, birthdays, and team availability.',
    href: `/resources/guides/${topicGuideMap['People Management']}`,
    icon: '/images/knowledge-base/icon-people-management.svg',
    articles: 3,
  },
  {
    title: 'Timesheets',
    body: 'Log time, submit for approval, and export billing reports.',
    href: `/resources/guides/${topicGuideMap.Timesheets}`,
    icon: '/images/knowledge-base/icon-timesheets.svg',
    articles: 3,
  },
  {
    title: 'Account & Billing',
    body: 'Manage your plan, users, billing details, and invoices.',
    href: `/resources/guides/${topicGuideMap['Account & Billing']}`,
    icon: '/images/knowledge-base/icon-account-billing.svg',
    articles: 3,
  },
];

const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout
  title="Pixeldesk Help Center — Knowledge Base"
  description="Find answers fast with the Pixeldesk Help Center. Setup guides, feature tutorials, FAQ, troubleshooting, and best practices for project management, client portals, sprint planning, and team management."
  canonicalPath="/resources/knowledge-base"
  topBg="rect-11"
>
  <Header current="resources" />
  <main class="kb-page">
    <section class="kb-hero relative overflow-hidden pt-[338.75px] pb-[143.75px]">
      <div class="pd-rail relative text-center">
        <h1 class="kb-hero__title">Knowledge Base</h1>
        <p class="kb-hero__subtitle">What do you need help with?</p>

        <form class="kb-search mx-auto mt-[72.5px] w-full max-w-[702.5px]" role="search" action="/resources/knowledge-base" method="get">
          <label class="sr-only" for="kb-search">Search knowledge base</label>
          <div class="kb-search__field">
            <input
              id="kb-search"
              name="q"
              type="search"
              value={initialQuery}
              placeholder="Search for features, guides, or questions…"
              class="kb-search__input"
              autocomplete="off"
            />
            <span class="kb-search__icon" aria-hidden="true">
              <img src="/images/resources/icon-search.svg" alt="" />
            </span>
          </div>
        </form>
      </div>
    </section>

    <section class="kb-cards pb-[345px]">
      <div class="pd-rail">
        <div class="kb-grid" id="kb-grid">
          {
            topics.map((topic) => (
              <a
                href={topic.href}
                class="kb-card"
                data-search-text={`${topic.title} ${topic.body}`}
              >
                <span class="kb-card__icon">
                  <span class="kb-card__icon-glow" aria-hidden="true">
                    <img src={topic.icon} alt="" />
                  </span>
                </span>
                <h2 class="kb-card__title">{topic.title}</h2>
                <p class="kb-card__body">{topic.body}</p>
                <span class="kb-card__chip">{topic.articles} articles</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .kb-hero__title {
    max-width: 888.75px;
    margin-inline: auto;
    font-size: 62.5px;
    font-weight: 500;
    line-height: 65px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .kb-hero__subtitle {
    margin: 17.5px auto 0;
    max-width: 892.5px;
    font-size: 20px;
    font-weight: 300;
    line-height: 30px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .kb-search__field {
    position: relative;
    height: 52.5px;
    border-radius: 26.25px;
    background: #fff;
    box-shadow: 7.5px 7.5px 41.25px rgba(108, 65, 255, 0.21);
  }

  .kb-search__input {
    box-sizing: border-box;
    width: 100%;
    height: 52.5px;
    padding: 0 56.25px 0 25px;
    border: 0;
    border-radius: 26.25px;
    background: transparent;
    font-size: 17.5px;
    font-weight: 300;
    line-height: 52.5px;
    color: #000945;
    outline: none;
  }

  .kb-search__input::placeholder {
    color: #878787;
  }

  .kb-search__icon {
    position: absolute;
    top: 50%;
    right: 26.25px;
    display: flex;
    width: 22.5px;
    height: 22.5px;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .kb-search__icon img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Figma 2021:1299 — 278×204 cards, 28px col / 35px row gaps, 65px rail inset */
  .kb-grid {
    display: grid;
    grid-template-columns: repeat(3, calc(278px * var(--pd-scale, 1.25)));
    column-gap: calc(28px * var(--pd-scale, 1.25));
    row-gap: calc(35px * var(--pd-scale, 1.25));
    width: 100%;
    padding-left: calc(65px * var(--pd-scale, 1.25));
    justify-content: start;
  }

  .kb-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: calc(15px * var(--pd-scale, 1.25));
    width: 100%;
    height: calc(204px * var(--pd-scale, 1.25));
    padding: calc(20px * var(--pd-scale, 1.25));
    border: calc(1px * var(--pd-scale, 1.25)) solid #e2e2e2;
    border-radius: calc(15px * var(--pd-scale, 1.25));
    background: #fff;
    box-shadow: none;
    text-decoration: none;
    color: inherit;
  }

  .kb-card[hidden] {
    display: none;
  }

  .kb-card__icon {
    position: relative;
    flex-shrink: 0;
    width: 51.25px;
    height: 51.25px;
  }

  .kb-card__icon-glow {
    position: absolute;
    inset: -34.15%;
  }

  .kb-card__icon-glow img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .kb-card__title {
    font-size: 25px;
    font-weight: 500;
    line-height: 30px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .kb-card__body {
    flex: 1;
    font-size: 15px;
    font-weight: 300;
    line-height: 22.5px;
    letter-spacing: 0;
    color: #000945;
    text-shadow: none;
  }

  .kb-card__chip {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    height: 22.5px;
    padding: 0 12.5px;
    border-radius: 50px;
    background: rgba(108, 65, 255, 0.11);
    color: #6c41ff;
    font-size: 11.25px;
    font-weight: 600;
    line-height: 17.5px;
    letter-spacing: 0;
    text-shadow: none;
  }

  .sr-only {
    position: absolute;
    width: 1.25px;
    height: 1.25px;
    padding: 0;
    margin: -1.25px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1199px) {
    .kb-grid {
      padding-left: 0;
      grid-template-columns: repeat(2, calc(278px * var(--pd-scale, 1.25)));
    }
  }

  @media (max-width: 767px) {
    .kb-hero {
      padding-top: 250px;
      padding-bottom: 80px;
    }

    .kb-hero__title {
      font-size: 50px;
      line-height: 52px;
    }

    .kb-hero__subtitle {
      font-size: 16px;
      line-height: 24px;
    }

    .kb-search {
      margin-top: 42.5px;
    }

    .kb-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .kb-card {
      width: 100%;
      height: auto;
      min-height: calc(204px * var(--pd-scale, 1.25));
    }

    .kb-cards {
      padding-bottom: 120px;
    }
  }
</style>

<script define:vars={{ initialQuery }}>
  function normalizeSearchQuery(value) {
    return value
      .trim()
      .toLowerCase()
      .replace(/[^\w\s]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function matchesSearchQuery(query, ...fields) {
    const normalized = normalizeSearchQuery(query);
    if (!normalized) return true;
    const haystack = fields.map((field) => normalizeSearchQuery(field)).join(' ');
    return normalized.split(' ').every((term) => haystack.includes(term));
  }

  const searchInput = document.getElementById('kb-search');
  const cards = document.querySelectorAll('.kb-card');
  const searchForm = searchInput?.closest('form');

  function filterTopics(query) {
    cards.forEach((card) => {
      const text = card.getAttribute('data-search-text') ?? '';
      const visible = matchesSearchQuery(query, text);
      card.hidden = !visible;
    });
  }

  searchInput?.addEventListener('input', () => {
    filterTopics(searchInput.value);
    const url = new URL(window.location.href);
    const value = searchInput.value.trim();
    if (value) url.searchParams.set('q', value);
    else url.searchParams.delete('q');
    window.history.replaceState({}, '', url);
  });

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    filterTopics(searchInput?.value ?? '');
  });

  if (initialQuery) {
    filterTopics(initialQuery);
  }
</script>
