---
import '../styles/global.css';
import PageTopBg from '../components/PageTopBg.astro';
import UnderDevelopment from '../components/UnderDevelopment.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Pixeldesk is under development. We're still working on it." />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Under Development | Pixeldesk</title>
  </head>
  <body class="relative min-h-dvh overflow-x-hidden bg-white">
    <PageTopBg />
    <div class="relative z-[1] flex min-h-dvh w-full items-center justify-center p-4 sm:p-6 md:p-8">
      <div class="under-dev-shell">
        <UnderDevelopment />
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Figma 2131:248 — Rectangle 21: 1010×779, radius 28px, shadow 6/6/33 @ 8% */
  .under-dev-shell {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: calc(1010px * var(--pd-scale));
    min-height: min(calc(779px * var(--pd-scale)), calc(100dvh - 2rem));
    overflow: hidden;
    border-radius: calc(28px * var(--pd-scale));
    background: #fff;
    box-shadow: calc(6px * var(--pd-scale)) calc(6px * var(--pd-scale))
      calc(33px * var(--pd-scale)) rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .under-dev-shell {
      min-height: min(calc(779px * var(--pd-scale)), calc(100dvh - 4rem));
    }
  }
</style>
