---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/blogs/BlogCard.astro';
import BlogSidebarCard from '../../components/blogs/BlogSidebarCard.astro';
import {
  fetchAllPublicBlogPosts,
  getRelatedBlogPosts,
  getMustReadBlogPosts,
  extractTocFromHtml,
  addHeadingIds,
} from '../../lib/api/blog.api';
import { articleSchema } from '../../lib/seo/schema';

export async function getStaticPaths() {
  try {
    const posts = await fetchAllPublicBlogPosts();
    return posts.map((post) => ({
      params: { slug: post.slug },
      props: { post, allPosts: posts },
    }));
  } catch (error) {
    console.warn('[blogs] getStaticPaths failed:', (error as Error).message);
    return [];
  }
}

const { post, allPosts } = Astro.props;
const canonicalPath = `/blogs/${post.slug}`;
const relatedPosts = getRelatedBlogPosts(allPosts, post, 3);
const mustReadPosts = getMustReadBlogPosts(allPosts, post, 3);

const bodyHtml = post.fullDescription ? addHeadingIds(post.fullDescription) : '';
const toc = bodyHtml ? extractTocFromHtml(bodyHtml) : [];
const heroImage = post.coverImageUrl || post.imageUrl;
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  canonicalPath={canonicalPath}
  ogType="article"
  topBg="rect-11"
  jsonLd={articleSchema({
    title: post.title,
    description: post.excerpt,
    dateIso: post.dateIso,
    slug: post.slug,
  })}
>
  <Header current="resources" />
  <main class="blog-detail">
    <article class="blog-detail__article">
      <div class="pd-rail blog-detail__rail">
        <header class="blog-detail__header">
          <h1 class="blog-detail__title">{post.title}</h1>
          <div class="blog-detail__meta">
            <span class="blog-detail__category">{post.category}</span>
            <time class="blog-detail__date" datetime={post.dateIso}>{post.date}</time>
          </div>
        </header>

        <div
          class="blog-detail__thumb"
          aria-hidden={!heroImage}
          style={heroImage ? `background-image:url('${heroImage}');background-size:cover;background-position:center;` : undefined}
        ></div>

        <div class="blog-detail__layout">
          <div class="blog-detail__main">
            <div class="blog-detail__content">
              {
                bodyHtml ? (
                  <div class="blog-detail__html" set:html={bodyHtml} />
                ) : (
                  <p class="blog-detail__paragraph">{post.excerpt}</p>
                )
              }
            </div>

            <footer class="blog-detail__footer">
              <p class="blog-detail__related-copy">
                Explore <a href="/features">Pixeldesk features</a> or see <a href="/pricing">pricing plans</a>.
              </p>
              <a href="/blogs" class="blog-detail__cta">Browse all articles</a>
            </footer>
          </div>

          <aside class="blog-detail__sidebar" aria-label="Article sidebar">
            {
              toc.length > 0 && (
                <div class="blog-detail__toc">
                  <h2 class="blog-detail__toc-title">In this article</h2>
                  <nav aria-label="Table of contents">
                    <ol class="blog-detail__toc-list">
                      {
                        toc.map((item) => (
                          <li>
                            <a href={`#${item.id}`}>{item.text}</a>
                          </li>
                        ))
                      }
                    </ol>
                  </nav>
                </div>
              )
            }

            {
              relatedPosts.length > 0 && (
                <div class="blog-detail__related-sidebar" aria-labelledby="related-blogs-title">
                  <div class="blog-detail__related-head">
                    <h2 id="related-blogs-title" class="blog-detail__toc-title">
                      Related in {post.category}
                    </h2>
                    <a
                      href={`/blogs?category=${encodeURIComponent(post.category)}`}
                      class="blog-detail__related-link"
                    >
                      View all
                    </a>
                  </div>
                  <div class="blog-detail__related-cards">
                    {relatedPosts.map((relatedPost) => (
                      <BlogSidebarCard post={relatedPost} />
                    ))}
                  </div>
                </div>
              )
            }
          </aside>
        </div>
      </div>
    </article>

    {
      mustReadPosts.length > 0 && (
        <section class="blog-detail__must-read" aria-labelledby="must-read-title">
          <div class="pd-rail">
            <div class="blog-detail__section-head">
              <h2 id="must-read-title" class="blog-detail__section-title">Must read</h2>
              <a href="/blogs" class="blog-detail__section-link">All articles →</a>
            </div>
            <div class="blog-detail__cards">
              {mustReadPosts.map((mustReadPost) => (
                <BlogCard post={mustReadPost} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Match blogs listing hero clearance (227px × --pd-scale) */
  .blog-detail {
    padding-top: calc(227px * var(--pd-scale, 1.25));
    padding-bottom: 0;
  }

  .blog-detail__rail {
    max-width: calc(980px * var(--pd-scale, 1.25));
  }

  .blog-detail__header {
    display: flex;
    flex-direction: column;
    gap: calc(20px * var(--pd-scale, 1.25));
    margin-bottom: calc(8px * var(--pd-scale, 1.25));
  }

  .blog-detail__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(12px * var(--pd-scale, 1.25));
  }

  .blog-detail__category {
    display: inline-flex;
    align-items: center;
    height: calc(23px * var(--pd-scale, 1.25));
    padding: calc(5px * var(--pd-scale, 1.25)) calc(10px * var(--pd-scale, 1.25));
    border-radius: calc(40px * var(--pd-scale, 1.25));
    background: rgba(108, 65, 255, 0.11);
    color: #6c41ff;
    font-size: calc(11px * var(--pd-scale, 1.25));
    font-weight: 600;
    line-height: calc(14px * var(--pd-scale, 1.25));
    text-transform: uppercase;
  }

  .blog-detail__title {
    margin: 0;
    font-size: calc(36px * var(--pd-scale, 1.25));
    font-weight: 500;
    line-height: calc(42px * var(--pd-scale, 1.25));
    color: #000945;
  }

  .blog-detail__date {
    font-size: calc(14px * var(--pd-scale, 1.25));
    font-weight: 300;
    line-height: calc(20px * var(--pd-scale, 1.25));
    color: #000945;
  }

  .blog-detail__thumb {
    width: 100%;
    height: calc(280px * var(--pd-scale, 1.25));
    margin-top: calc(28px * var(--pd-scale, 1.25));
    border-radius: calc(12px * var(--pd-scale, 1.25));
    background: #d9d9d9;
  }

  .blog-detail__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(260px * var(--pd-scale, 1.25));
    gap: calc(48px * var(--pd-scale, 1.25));
    align-items: start;
    margin-top: calc(36px * var(--pd-scale, 1.25));
  }

  .blog-detail__main {
    min-width: 0;
  }

  .blog-detail__content {
    display: flex;
    flex-direction: column;
    gap: calc(32px * var(--pd-scale, 1.25));
  }

  .blog-detail__html :global(h2) {
    scroll-margin-top: calc(120px * var(--pd-scale, 1.25));
  }

  .blog-detail__paragraph {
    margin: 0;
    font-size: calc(16px * var(--pd-scale, 1.25));
    font-weight: 300;
    line-height: calc(26px * var(--pd-scale, 1.25));
    color: #000945;
  }

  .blog-detail__sidebar {
    position: sticky;
    top: calc(120px * var(--pd-scale, 1.25));
    display: flex;
    flex-direction: column;
    gap: calc(20px * var(--pd-scale, 1.25));
  }

  .blog-detail__toc,
  .blog-detail__related-sidebar {
    padding: calc(20px * var(--pd-scale, 1.25));
    border: calc(1px * var(--pd-scale, 1.25)) solid #e2e2e2;
    border-radius: calc(12px * var(--pd-scale, 1.25));
    background: #fff;
  }

  .blog-detail__toc-title {
    margin: 0 0 calc(14px * var(--pd-scale, 1.25));
    font-size: calc(14px * var(--pd-scale, 1.25));
    font-weight: 600;
    line-height: calc(18px * var(--pd-scale, 1.25));
    color: #000945;
  }

  .blog-detail__toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: calc(10px * var(--pd-scale, 1.25));
  }

  .blog-detail__toc-list a {
    color: #444;
    font-size: calc(13px * var(--pd-scale, 1.25));
    font-weight: 400;
    line-height: calc(18px * var(--pd-scale, 1.25));
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .blog-detail__toc-list a:hover {
    color: #6c41ff;
  }

  .blog-detail__related-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: calc(8px * var(--pd-scale, 1.25));
    margin-bottom: calc(14px * var(--pd-scale, 1.25));
  }

  .blog-detail__related-head .blog-detail__toc-title {
    margin: 0;
  }

  .blog-detail__related-link {
    flex-shrink: 0;
    color: #6c41ff;
    font-size: calc(11px * var(--pd-scale, 1.25));
    font-weight: 500;
    line-height: calc(18px * var(--pd-scale, 1.25));
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .blog-detail__related-link:hover {
    opacity: 0.85;
  }

  .blog-detail__related-cards {
    display: flex;
    flex-direction: column;
    gap: calc(10px * var(--pd-scale, 1.25));
  }

  .blog-detail__related-copy {
    margin: 0 0 calc(20px * var(--pd-scale, 1.25));
    font-size: calc(15px * var(--pd-scale, 1.25));
    line-height: calc(22px * var(--pd-scale, 1.25));
    color: #3d3d3d;
  }

  .blog-detail__related-copy a {
    color: #6c41ff;
    font-weight: 500;
  }

  .blog-detail__footer {
    margin-top: calc(48px * var(--pd-scale, 1.25));
    padding-top: calc(32px * var(--pd-scale, 1.25));
    padding-bottom: calc(80px * var(--pd-scale, 1.25));
    border-top: calc(1px * var(--pd-scale, 1.25)) solid #e2e2e2;
  }

  .blog-detail__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: calc(34px * var(--pd-scale, 1.25));
    padding: calc(10px * var(--pd-scale, 1.25)) calc(18px * var(--pd-scale, 1.25));
    border-radius: calc(40px * var(--pd-scale, 1.25));
    background: #000945;
    color: #fff;
    font-size: calc(14px * var(--pd-scale, 1.25));
    font-weight: 500;
    line-height: calc(18px * var(--pd-scale, 1.25));
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .blog-detail__cta:hover {
    background: #6c41ff;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(108, 65, 255, 0.28);
  }

  .blog-detail__cta:focus-visible {
    outline: 2px solid #6c41ff;
    outline-offset: 2px;
  }

  .blog-detail__must-read {
    padding-top: calc(20px * var(--pd-scale, 1.25));
    padding-bottom: calc(80px * var(--pd-scale, 1.25));
  }

  .blog-detail__section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: calc(16px * var(--pd-scale, 1.25));
    margin-bottom: calc(42px * var(--pd-scale, 1.25));
  }

  .blog-detail__section-title {
    margin: 0;
    font-size: calc(20px * var(--pd-scale, 1.25));
    font-weight: 500;
    line-height: calc(22px * var(--pd-scale, 1.25));
    color: #000945;
  }

  .blog-detail__section-link {
    flex-shrink: 0;
    color: #6c41ff;
    font-size: calc(13px * var(--pd-scale, 1.25));
    font-weight: 500;
    line-height: calc(18px * var(--pd-scale, 1.25));
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .blog-detail__section-link:hover {
    opacity: 0.85;
  }

  .blog-detail__cards {
    display: grid;
    grid-template-columns: repeat(3, calc(300px * var(--pd-scale, 1.25)));
    column-gap: calc(40px * var(--pd-scale, 1.25));
    row-gap: calc(42px * var(--pd-scale, 1.25));
    justify-content: start;
  }

  @media (max-width: 1199px) {
    .blog-detail__cards {
      grid-template-columns: repeat(2, calc(300px * var(--pd-scale, 1.25)));
    }
  }

  @media (max-width: 991px) {
    .blog-detail__layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .blog-detail__sidebar {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 767px) {
    .blog-detail {
      padding-top: 220px;
    }

    .blog-detail__title {
      font-size: calc(28px * var(--pd-scale, 1.25));
      line-height: calc(34px * var(--pd-scale, 1.25));
    }

    .blog-detail__thumb {
      height: calc(200px * var(--pd-scale, 1.25));
    }

    .blog-detail__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .blog-detail__section-head {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
