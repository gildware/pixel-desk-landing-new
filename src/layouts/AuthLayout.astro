---
import '../styles/global.css';
import PageTopBg from '../components/PageTopBg.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sign in | Pixeldesk',
  description = 'Sign in to your Pixeldesk account.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="relative min-h-dvh bg-white">
    <PageTopBg />
    <div class="relative z-[1] flex min-h-dvh w-full items-center justify-center p-4 sm:p-6 md:p-8">
      <div class="auth-shell">
        <header class="auth-shell__header">
          <a href="/login" class="inline-flex items-center" aria-label="Pixeldesk home">
            <img
              src="/images/logo.svg"
              alt="Pixeldesk"
              width="155"
              height="30"
              class="auth-shell__logo"
            />
          </a>
          <a href="/home" class="pd-btn-login">Home</a>
        </header>

        <main class="auth-shell__main">
          <div class="auth-form-wrap">
            <slot />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
