---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Your next project deserves a better home.',
  subtitle = "Join thousands of teams who've replaced disconnected tools with one workspace that actually works.",
} = Astro.props;
---

<section class="cta-band">
  <div class="pd-rail">
    <div class="cta-band__panel">
      <h2 class="cta-band__title">{title}</h2>
      <p class="cta-band__subtitle">{subtitle}</p>
      <div class="cta-band__actions">
        <a href="/pricing" class="cta-band__btn">Start free today</a>
        <a href="#" class="cta-band__btn">Book a live demo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-bottom: 180px;
  }

  /* Rectangle 13 — Frame 948 */
  .cta-band__panel {
    display: flex;
    min-height: 312.5px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 46.25px 40px;
    border-radius: 35px;
    background: #6c41ff;
    color: #fff;
    text-align: center;
  }

  .cta-band__title {
    margin: 0;
    max-width: 520px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 500;
    line-height: 43.75px;
  }

  .cta-band__subtitle {
    margin: 10px 0 0;
    max-width: 568.75px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 300;
    line-height: 21.25px;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 28.75px;
    margin-top: 37.5px;
  }

  .cta-band__btn {
    display: inline-flex;
    width: 183.75px;
    height: 42.5px;
    align-items: center;
    justify-content: center;
    padding: 12.5px;
    border: 1px solid #fff;
    border-radius: 31.25px;
    background: transparent;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 400;
    line-height: 17.5px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cta-band__btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }
</style>
