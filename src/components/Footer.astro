---
const product = [
  { href: '/features', label: 'Features' },
  { href: '/pricing', label: 'Pricing' },
  { href: '#', label: 'Roadmap' },
];

const company = [
  { href: '#', label: 'About' },
  { href: '#', label: 'Blog' },
  { href: '#', label: 'Careers' },
  { href: '#', label: 'Press' },
];

const support = [
  { href: '/resources/knowledge-base', label: 'Help Center' },
  { href: '#', label: 'Contact' },
  { href: '#', label: 'Privacy' },
  { href: '#', label: 'Terms' },
];

const columns = [
  { title: 'Product', links: product },
  { title: 'Company', links: company },
  { title: 'Support', links: support },
];
---

<footer class="site-footer">
  <div class="pd-rail site-footer__rail">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          src="/images/logo-white.svg"
          alt="Pixeldesk"
          width="168"
          height="34"
          class="site-footer__logo"
        />
        <p class="site-footer__tagline">
          The complete project OS for modern teams. Manage projects, delight clients, and take care of your people — all
          in one workspace.
        </p>
      </div>

      {
        columns.map((column) => (
          <div class="site-footer__col">
            <p class="site-footer__heading">{column.title}</p>
            <ul class="site-footer__links">
              {column.links.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>© 2026 Pixeldesk. All rights reserved.</p>
      <p class="site-footer__motto">Work smarter. Deliver better.</p>
    </div>
  </div>
</footer>

<style>
  /* Rectangle 14 — footer rail */
  .site-footer {
    background: #000945;
    color: #fff;
  }

  .site-footer__rail {
    padding-top: 40px;
    padding-bottom: 15px;
  }

  .site-footer__grid {
    display: grid;
    align-items: start;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr) repeat(3, auto);
      column-gap: clamp(2rem, 5vw, 81.25px);
      row-gap: 0;
    }
  }

  .site-footer__brand {
    max-width: 293.75px;
  }

  .site-footer__logo {
    display: block;
    width: 210px;
    height: 42.5px;
  }

  .site-footer__tagline {
    margin: 22.5px 0 0;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 20px;
  }

  .site-footer__heading {
    margin: 0;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
    gap: 12.5px;
    margin: 12.5px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 20px;
  }

  .site-footer__links a {
    color: #fff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .site-footer__links a:hover {
    opacity: 0.85;
  }

  /* Line 7 — bottom bar */
  .site-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 112.5px;
    padding-top: 11.25px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 12.5px;
    font-weight: 300;
    line-height: 20px;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  @media (min-width: 640px) {
    .site-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .site-footer__motto {
    text-align: inherit;
  }

  @media (min-width: 640px) {
    .site-footer__motto {
      text-align: right;
    }
  }
</style>
