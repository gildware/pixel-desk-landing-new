---
const ASSET = '/images/figma/features-hero';

/** Figma Features frame — hero visual crop (Ellipse 11 top → fade bottom) */
const FIGMA = { x: 251, y: 200, w: 1010, h: 483 };

const figmaBox = (x, y, w, h) => ({
  left: `${(((x - FIGMA.x) / FIGMA.w) * 100).toFixed(4)}%`,
  top: `${(((y - FIGMA.y) / FIGMA.h) * 100).toFixed(4)}%`,
  width: `${((w / FIGMA.w) * 100).toFixed(4)}%`,
  height: `${((h / FIGMA.h) * 100).toFixed(4)}%`,
});

const dashBox = figmaBox(481, 358, 551, 308);
const fadeBox = figmaBox(463, 447, 586, 236);

/** Arc orbs left → right with Figma-exported SVG glyphs */
const arcMarkers = [
  { orb: figmaBox(337, 374, 46, 46), icon: { ...figmaBox(350, 386, 20.5, 20.5), src: `${ASSET}/icon-dashboard.svg` } },
  { orb: figmaBox(414, 292, 46, 46), icon: { ...figmaBox(425, 305, 23, 19), src: `${ASSET}/icon-project.svg` } },
  { orb: figmaBox(503, 235, 46, 46), icon: { ...figmaBox(515, 249, 22, 17.77), src: `${ASSET}/icon-sprint.svg` } },
  { orb: figmaBox(609, 195, 46, 46), icon: { ...figmaBox(623, 210, 17.94, 15.25), src: `${ASSET}/icon-people.svg` } },
  { orb: figmaBox(735, 180, 46, 46), icon: { ...figmaBox(747, 192, 23, 23), src: `${ASSET}/icon-portal.svg` } },
  { orb: figmaBox(856, 195, 46, 46), icon: { ...figmaBox(869, 208, 19.7, 18.4), src: `${ASSET}/icon-notice.svg` } },
  { orb: figmaBox(971, 235, 46, 46), icon: { ...figmaBox(983, 247, 21, 21), src: `${ASSET}/icon-timesheet.svg` } },
  { orb: figmaBox(1058, 292, 46, 46), icon: { ...figmaBox(1071, 308, 20, 20), src: `${ASSET}/icon-chat.svg` } },
  { orb: figmaBox(1134, 374, 46, 46), icon: { ...figmaBox(1147, 386, 20, 20), src: `${ASSET}/icon-feedback.svg` } },
];

const features = [
  { label: 'Dashboard', icon: `${ASSET}/pill-dashboard.svg` },
  { label: 'Project Management', icon: `${ASSET}/pill-project.svg` },
  { label: 'Sprint Planning', icon: `${ASSET}/pill-sprint.svg` },
  { label: 'People Management', icon: `${ASSET}/pill-people.svg` },
  { label: 'Client Portal', icon: `${ASSET}/pill-portal.svg` },
  { label: 'Notice Board', icon: `${ASSET}/pill-notice.svg` },
  { label: 'Timesheets', icon: `${ASSET}/pill-timesheet.svg` },
  { label: 'Team Chat', icon: `${ASSET}/pill-chat.svg` },
  { label: 'Feedback System', icon: `${ASSET}/pill-feedback.svg` },
];

const row1 = features.slice(0, 5);
const row2 = features.slice(5);

const boxStyle = (box) =>
  `left:${box.left};top:${box.top};width:${box.width};height:${box.height};`;
---

<section class="features-hero relative overflow-x-clip pt-[147.5px] pb-12 sm:pt-[250px] sm:pb-[103.75px]">
  <div class="pd-rail relative z-[1]">
    <div class="features-hero__visual mx-auto" aria-label="Pixeldesk product features preview">
      <!-- Figma Ellipse 11 — SVG arc (PNG export had opaque white fill) -->
      <img
        src={`${ASSET}/arc.svg`}
        alt=""
        class="features-hero__arc"
        width="1010"
        height="498"
        aria-hidden="true"
      />

      <!-- Figma 2018:100 — dashboard with purple border + radius -->
      <div class="features-hero__dash" style={boxStyle(dashBox)}>
        <div class="features-hero__dash-frame">
          <img
            src={`${ASSET}/dashboard.png`}
            alt="Pixeldesk dashboard showing deliverables, tasks, and utilization"
            width="551"
            height="308"
            class="features-hero__dash-img"
            fetchpriority="high"
          />
        </div>
      </div>

      <!-- Figma 2018:101 — Rectangle 18 white gradient fade (SVG export) -->
      <img
        src={`${ASSET}/dashboard-fade.svg`}
        alt=""
        class="features-hero__dash-fade"
        style={boxStyle(fadeBox)}
        width="586"
        height="236"
        aria-hidden="true"
      />

      <!-- Figma Ellipse 12…20 — white circle + purple glow (74px asset in 46px slot) -->
      <ul class="features-hero__arc-icons" aria-hidden="true">
        {
          arcMarkers.map((item) => (
            <li class="features-hero__arc-marker">
              <div class="features-hero__arc-orb-slot" style={boxStyle(item.orb)}>
                <div class="features-hero__arc-orb-wrap">
                  <img src={`${ASSET}/orb.svg`} alt="" class="features-hero__arc-orb" width="74" height="74" />
                </div>
              </div>
              <img src={item.icon.src} alt="" class="features-hero__arc-glyph" style={boxStyle(item.icon)} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="features-hero__copy mx-auto text-center">
      <h1 class="features-hero__title">
        Every feature your team needs.<br />In one workspace.
      </h1>
      <p class="features-hero__subtitle">
        Built for three audiences at once — the Project Manager who needs control, the team that needs clarity, and the
        client who needs confidence in what’s being delivered.
      </p>
      <span class="features-hero__cta">EVERYTHING. ONE PLACE.</span>
    </div>

    <div class="features-hero__pills">
      <div class="features-hero__pill-row features-hero__pill-row--1">
        {
          row1.map((pill) => (
            <span class="features-hero__pill">
              <img src={pill.icon} alt="" width="15" height="15" class="features-hero__pill-icon" />
              {pill.label}
            </span>
          ))
        }
      </div>
      <div class="features-hero__pill-row features-hero__pill-row--2">
        {
          row2.map((pill) => (
            <span class="features-hero__pill">
              <img src={pill.icon} alt="" width="15" height="15" class="features-hero__pill-icon" />
              {pill.label}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .features-hero {
    --fh-purple: #6c41ff;
    --fh-purple-soft: rgba(108, 65, 255, 0.11);
    --fh-navy: #000945;
    /* Transparent so BaseLayout PageTopBg (Rectangle 11) shows through */
    background: transparent;
  }

  .features-hero__visual {
    position: relative;
    width: 100%;
    max-width: calc(1010px * var(--pd-scale, 1.25));
    aspect-ratio: 1010 / 483;
    overflow: visible;
  }

  .features-hero__arc {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: auto;
    pointer-events: none;
    z-index: 0;
  }

  .features-hero__dash {
    position: absolute;
    z-index: 1;
  }

  /* Figma 2018:100 — border + radius only (fade is separate Rectangle 18 SVG) */
  .features-hero__dash-frame {
    width: 100%;
    height: 100%;
    border: 8.75px solid rgba(108, 65, 255, 0.1);
    border-radius: 17.5px;
    overflow: hidden;
  }

  .features-hero__dash-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .features-hero__dash-fade {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    object-fit: cover;
  }

  .features-hero__arc-icons {
    position: absolute;
    inset: 0;
    z-index: 3;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .features-hero__arc-marker {
    position: static;
  }

  /* Figma Ellipse 12 — 46px slot; glow wrapper extends -30.43% per side */
  .features-hero__arc-orb-slot {
    position: absolute;
    z-index: 0;
  }

  .features-hero__arc-orb-wrap {
    position: absolute;
    inset: -30.43%;
  }

  .features-hero__arc-orb {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    pointer-events: none;
  }

  .features-hero__arc-glyph {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    object-fit: contain;
  }

  /* Figma 2018:102 — plain text, no background; sits over fade wash */
  .features-hero__copy {
    position: relative;
    z-index: 5;
    margin-top: -71.25px;
    max-width: 888.75px;
    background: transparent;
  }

  .features-hero__title {
    color: var(--fh-navy);
    font-family: var(--font-sans);
    font-size: 42.5px;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.02em;
    background: transparent;
  }

  @media (min-width: 640px) {
    .features-hero__title {
      font-size: 60px;
      line-height: 65px;
    }
  }

  .features-hero__subtitle {
    margin: 23.75px auto 0;
    max-width: 892.5px;
    color: var(--fh-navy);
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 300;
    line-height: 30px;
  }

  .features-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 67.5px;
    height: 25px;
    padding: 0 26.875px;
    border-radius: 62.5px;
    background: var(--fh-purple);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 11.25px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 17.5px;
    text-transform: uppercase;
  }

  .features-hero__pills {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18.75px;
    width: min(100%, 1025px);
    margin: 21.25px auto 0;
  }

  .features-hero__pill-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .features-hero__pill-row--1 {
    gap: 22.5px;
  }

  .features-hero__pill-row--2 {
    gap: 20px;
  }

  @media (min-width: 900px) {
    .features-hero__pill-row {
      flex-wrap: nowrap;
    }
  }

  .features-hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 12.5px;
    height: 32.5px;
    padding: 0 13.75px;
    border-radius: 10px;
    background: var(--fh-purple-soft);
    color: var(--fh-purple);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 15px;
    white-space: nowrap;
  }

  .features-hero__pill-icon {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    display: block;
  }

  @media (max-width: 639px) {
    .features-hero__visual {
      aspect-ratio: 1010 / 520;
    }

    .features-hero__copy {
      margin-top: -40px;
    }

    .features-hero__dash-frame {
      border-width: 6px;
      border-radius: 12px;
    }

    .features-hero__subtitle {
      margin-top: 15px;
      font-size: 17.5px;
      line-height: 26.25px;
    }

    .features-hero__cta {
      margin-top: 40px;
      height: 22.5px;
      font-size: 10px;
    }

    .features-hero__pills {
      margin-top: 17.5px;
      gap: 12.5px;
    }

    .features-hero__pill-row--1,
    .features-hero__pill-row--2 {
      gap: 10px;
    }

    .features-hero__pill {
      height: 30px;
      font-size: 13.75px;
      gap: 10px;
      padding: 0 11.25px;
    }

    .features-hero__pill-icon {
      width: 13.75px;
      height: 13.75px;
    }
  }
</style>
