---
const audiences = ['Design Studios', 'Corporates', 'Consultancies', 'IT companies'];
---

<link rel="preload" as="image" href="/images/figma/hero-parts/project.svg" fetchpriority="high" />

<section class="pd-hero-gradient relative overflow-x-clip pb-0 pt-[361.25px]">
  <div
    class="pd-rail grid items-start gap-y-8 xl:grid-cols-[minmax(0,528.75px)_minmax(0,623.75px)] xl:gap-x-[110px] xl:gap-y-0"
  >
    <div class="hero-copy pl-[2.5px]">
      <h1 class="hero-copy__title">
        Where projects get<br class="hero-copy__br" /><span class="hero-copy__join" aria-hidden="true">{' '}</span>done — and <span class="text-purple">teams<br class="hero-copy__br" /><span class="hero-copy__join" aria-hidden="true">{' '}</span>actually thrive.</span>
      </h1>
      <p class="hero-copy__body">
        Managing a project means juggling tasks, timelines, team wellbeing, and client expectations all at once.
        Pixeldesk brings every piece of that picture into a single, intelligent workspace — so nothing slips through
        the gaps and everyone always knows where things stand.
      </p>
      <a href="/pricing" class="hero-copy__cta">Start for free</a>
    </div>

    <div
      class="hero-visual relative mx-auto aspect-[499/455.5] w-full max-w-[623.75px] shrink-0 overflow-hidden xl:-mt-[61.25px] xl:mx-0 xl:justify-self-start"
      data-hero-visual
      aria-label="Pixeldesk product preview"
    >
      <img
        src="/images/figma/hero-parts/purple-b.svg"
        alt=""
        width="358"
        height="250"
        class="hero-part hero-part--purple-b"
        style="--from-x: 18px; --from-y: -10px; --delay: 0ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/purple-a.svg"
        alt=""
        width="358"
        height="250"
        class="hero-part hero-part--purple-a"
        style="--from-x: -16px; --from-y: 14px; --delay: 40ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/map.svg"
        alt=""
        width="157"
        height="120"
        class="hero-part hero-part--map"
        style="--from-x: -35px; --from-y: 12.5px; --delay: 180ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/people.svg"
        alt=""
        width="170"
        height="144"
        class="hero-part hero-part--people"
        style="--from-x: 30px; --from-y: -5px; --delay: 320ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/today.svg"
        alt=""
        width="192"
        height="128"
        class="hero-part hero-part--today"
        style="--from-x: 30px; --from-y: 35px; --delay: 400ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/project.svg"
        alt=""
        width="198"
        height="198"
        class="hero-part hero-part--project hero-part--lcp"
        style="--from-x: 0px; --from-y: -37.5px; --delay: 0ms;"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/stars.svg"
        alt=""
        width="71"
        height="12"
        class="hero-part hero-part--stars"
        style="--from-x: 0px; --from-y: -17.5px; --delay: 260ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/folder.svg"
        alt=""
        width="39"
        height="40"
        class="hero-part hero-part--folder"
        style="--from-x: -25px; --from-y: 0px; --delay: 140ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/sprint.svg"
        alt="Sprint Plan"
        width="57"
        height="17"
        class="hero-part hero-part--sprint"
        style="--from-x: 0px; --from-y: 17.5px; --delay: 560ms;"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="pd-rail hero-audience mt-[188.125px] text-center">
    <span class="hero-audience__label">Useful tool for</span>
    <div class="hero-audience__grid">
      {
        audiences.map((name) => (
          <div class="hero-audience-card">{name}</div>
        ))
      }
    </div>

    <img
      src="/images/dashboard-preview-image0_2022_2173.webp"
      alt="Pixeldesk dashboard showing project summaries, status, and team widgets"
      width="931"
      height="543"
      class="hero-dashboard-preview"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style is:global>
  .hero-part {
    position: absolute;
    opacity: 0;
    transform: translate3d(var(--from-x, 0), var(--from-y, 0), 0);
    transition:
      opacity 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      transform 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
    will-change: transform, opacity;
    display: block;
    height: auto;
    object-fit: contain;
  }

  .hero-visual.is-ready .hero-part {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* PD-Website-UI-2026 Home hero — layout.json (499×455.5) */
  .hero-part--purple-b {
    top: 8.46%;
    left: 0;
    z-index: 0;
    width: 71.68%;
    height: 54.88%;
  }

  .hero-part--purple-a {
    top: 37.96%;
    left: 28.32%;
    z-index: 0;
    width: 71.68%;
    height: 54.88%;
  }

  .hero-part--map {
    top: 54.23%;
    left: 6.21%;
    z-index: 2;
    width: 31.29%;
    height: 26.25%;
  }

  .hero-part--people {
    top: 41.22%;
    left: 58.61%;
    z-index: 4;
    width: 34.06%;
    height: 31.57%;
  }

  .hero-part--today {
    top: 72.02%;
    left: 57.43%;
    z-index: 6;
    width: 36.63%;
    height: 27.98%;
  }

  .hero-part--project {
    top: 0;
    left: 22.38%;
    z-index: 7;
    width: 39.6%;
    height: 43.39%;
  }

  /* LCP hero card — visible while loading; no fade-in delay */
  .hero-part--lcp {
    opacity: 1;
  }

  .hero-visual.is-ready .hero-part--lcp {
    opacity: 1;
  }

  .hero-part--stars {
    top: 33.37%;
    left: 73.15%;
    z-index: 8;
    width: 14.21%;
    height: 2.61%;
  }

  .hero-part--folder {
    top: 43.47%;
    left: 13.83%;
    z-index: 9;
    width: 7.82%;
    height: 8.78%;
  }

  .hero-part--sprint {
    top: 82.33%;
    left: 20.24%;
    z-index: 9;
    width: 11.42%;
    height: 3.73%;
  }

  /* Figma Frame 923 styling at the requested 200% rendered size */
  .hero-audience__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 182.5px;
    height: 35px;
    margin: 0;
    border-radius: 100px;
    background: rgba(108, 65, 255, 0.11);
    color: var(--color-purple);
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 35px;
    white-space: nowrap;
    vertical-align: middle;
  }

  /* Frame 979 — 691×84 row, Frame 925 cards 160×84, gap 17 */
  .hero-audience__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 21.25px;
    width: 100%;
    max-width: 863.75px;
    margin: 38.75px auto 0;
  }

  /* image 1 (2022:2173): 191px below cards → visible top; SVG has 19px top bleed */
  .hero-dashboard-preview {
    display: block;
    width: 100%;
    max-width: 1163.75px;
    height: auto;
    margin: 238.75px auto 0;
  }

  /* Frame 925 — rx=10, fill #F0F0F0, label 15/25 Outfit Medium #000945 */
  .hero-audience-card {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: 105px;
    padding: 12.5px 10px;
    border-radius: 12.5px;
    background: #f0f0f0;
    color: #000945;
    font-size: 18.75px;
    font-weight: 500;
    line-height: 31.25px;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero-audience__grid {
      display: flex;
      flex-wrap: nowrap;
      justify-content: center;
    }

    .hero-audience-card {
      width: 200px;
      min-height: 105px;
      height: 105px;
      padding: 0;
      flex: 0 0 200px;
    }
  }

  /* Left hero copy — Figma nodes 2022:1561–1564 @ --pd-scale (×1.25) */
  .hero-copy__title {
    max-width: 526.25px;
    font-size: clamp(32px, 9.5vw, 55px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
    color: #000945;
  }

  .hero-copy__br {
    display: none;
  }

  /* Keeps word spacing when line-break <br>s are hidden on phone */
  .hero-copy__join {
    display: inline;
  }

  @media (min-width: 640px) {
    .hero-copy__title {
      font-size: 55px;
      line-height: 60px;
    }

    .hero-copy__br {
      display: block;
    }

    .hero-copy__join {
      display: none;
    }
  }

  .hero-copy__body {
    margin-top: 23.75px;
    margin-left: 1.25px;
    max-width: 501.25px;
    font-size: 17.5px;
    font-weight: 300;
    line-height: 25px;
    color: #000945;
  }

  /* Frame 957: no fill, 1px #6c41ff stroke, radius 25, navy label */
  .hero-copy__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin-top: 41.25px;
    min-width: 163.75px;
    height: 42.5px;
    padding: 0 30px;
    border-radius: 31.25px;
    background: transparent;
    color: #000945;
    font-size: 17.5px;
    font-weight: 400;
    line-height: 17.5px;
    white-space: nowrap;
    border: 1.25px solid #6c41ff;
    transition: background 0.15s ease;
  }

  .hero-copy__cta:hover {
    background: rgba(108, 65, 255, 0.08);
  }

  @media (max-width: 1023px) {
    .pd-hero-gradient {
      padding-top: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-part {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }
</style>

<script>
  function playHeroVisual() {
    document.querySelectorAll('[data-hero-visual]').forEach((el) => {
      el.classList.remove('is-ready');
      void el.offsetWidth;
      requestAnimationFrame(() => el.classList.add('is-ready'));
    });
  }

  playHeroVisual();
  document.addEventListener('astro:page-load', playHeroVisual);
</script>
