---
type AudienceCard = {
  title: string;
  titleLines?: [string, string];
  body: string;
  bodySize: 'sm' | 'md';
  iconDefault: string;
  iconHover: string;
  iconGlyphDefault?: string;
  iconGlyphHover?: string;
};

/** Figma Home 2022:1551 — audience cards 2197:343–373 */
const audienceCards: AudienceCard[] = [
  {
    title: 'Design Agencies',
    titleLines: ['Design', 'Agencies'],
    body: 'Streamline creative projects, client approvals, and team collaboration from a single dashboard.',
    bodySize: 'sm',
    iconDefault: '/images/figma/hero-audience/design-agencies-default-icon.svg',
    iconHover: '/images/figma/hero-audience/design-agencies-hover-icon.svg',
  },
  {
    title: 'Corporate Consulting',
    body: 'Manage engagements, track billable work, and keep clients informed with real-time project visibility.',
    bodySize: 'md',
    iconDefault: '/images/figma/hero-audience/corporate-consulting-default-icon.svg',
    iconHover: '/images/figma/hero-audience/corporate-consulting-hover-icon.svg',
  },
  {
    title: 'Software & IT Services',
    body: 'Plan sprints, manage development workflows, and deliver products faster with agile project tracking.',
    bodySize: 'md',
    iconDefault: '/images/figma/hero-audience/software-it-default-circle.svg',
    iconHover: '/images/figma/hero-audience/software-it-hover-circle.svg',
    iconGlyphDefault: '/images/figma/hero-audience/software-it-default-glyph.svg',
    iconGlyphHover: '/images/figma/hero-audience/software-it-hover-glyph.svg',
  },
  {
    title: 'Architecture & Engineering',
    body: 'Coordinate project milestones, resources, and stakeholder updates with complete visibility.',
    bodySize: 'md',
    iconDefault: '/images/figma/hero-audience/architecture-default-icon.svg',
    iconHover: '/images/figma/hero-audience/architecture-hover-icon.svg',
  },
];
---

<link rel="preload" as="image" href="/images/figma/hero-parts/project.svg" fetchpriority="high" />

<section class="pd-hero-gradient relative overflow-x-clip pb-0 pt-[361.25px]">
  <div
    class="pd-rail grid items-start gap-y-8 xl:grid-cols-[minmax(0,528.75px)_minmax(0,623.75px)] xl:gap-x-[110px] xl:gap-y-0"
  >
    <div class="hero-copy pl-[2.5px]">
      <h1 class="hero-copy__title">
        Where projects get<br class="hero-copy__br" /><span class="hero-copy__join" aria-hidden="true">{' '}</span>done — and <span class="text-purple">teams<br class="hero-copy__br" /><span class="hero-copy__join" aria-hidden="true">{' '}</span>actually thrive.</span>
      </h1>
      <p class="hero-copy__body">
        Managing a project means juggling tasks, timelines, team wellbeing, and client expectations all at once.
        Pixeldesk brings every piece of that picture into a single, intelligent workspace — so nothing slips through
        the gaps and everyone always knows where things stand.
      </p>
      <a href="/pricing" class="hero-copy__cta">Start for free</a>
    </div>

    <div
      class="hero-visual relative mx-auto aspect-[499/455.5] w-full max-w-[623.75px] shrink-0 overflow-visible xl:-mt-[61.25px] xl:mx-0 xl:justify-self-start"
      data-hero-visual
      aria-label="Pixeldesk product preview"
    >
      <img
        src="/images/figma/hero-parts/purple-b.svg"
        alt=""
        width="358"
        height="250"
        class="hero-part hero-part--purple-b"
        style="--from-x: 18px; --from-y: -10px; --delay: 0ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/purple-a.svg"
        alt=""
        width="358"
        height="250"
        class="hero-part hero-part--purple-a"
        style="--from-x: -16px; --from-y: 14px; --delay: 40ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/map.svg"
        alt=""
        width="157"
        height="120"
        class="hero-part hero-part--map"
        style="--from-x: -35px; --from-y: 12.5px; --delay: 180ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/people.svg"
        alt=""
        width="170"
        height="144"
        class="hero-part hero-part--people"
        style="--from-x: 30px; --from-y: -5px; --delay: 320ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/today.svg"
        alt=""
        width="192"
        height="128"
        class="hero-part hero-part--today"
        style="--from-x: 30px; --from-y: 35px; --delay: 400ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/project.svg"
        alt=""
        width="198"
        height="198"
        class="hero-part hero-part--project hero-part--lcp"
        style="--from-x: 0px; --from-y: -37.5px; --delay: 0ms;"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/stars.svg"
        alt=""
        width="71"
        height="12"
        class="hero-part hero-part--stars"
        style="--from-x: 0px; --from-y: -17.5px; --delay: 260ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/folder.svg"
        alt=""
        width="39"
        height="40"
        class="hero-part hero-part--folder"
        style="--from-x: -25px; --from-y: 0px; --delay: 140ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/sprint.svg"
        alt="Sprint Plan"
        width="57"
        height="17"
        class="hero-part hero-part--sprint"
        style="--from-x: 0px; --from-y: 17.5px; --delay: 560ms;"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="pd-rail hero-audience mt-[188.125px] text-center">
    <span class="hero-audience__label">Useful tool for</span>
    <div class="hero-audience__grid">
      {
        audienceCards.map((card) => (
          <button type="button" class="hero-audience-card">
            <span class="hero-audience-card__title">
              {
                card.titleLines ? (
                  <>
                    {card.titleLines[0]}
                    <br />
                    {card.titleLines[1]}
                  </>
                ) : (
                  card.title
                )
              }
            </span>
            <p class:list={['hero-audience-card__body', card.bodySize === 'sm' && 'hero-audience-card__body--sm']}>
              {card.body}
            </p>
            <span class="hero-audience-card__icon" aria-hidden="true">
              {
                card.iconGlyphDefault ? (
                  <>
                    <span class="hero-audience-card__icon-img hero-audience-card__icon-img--default">
                      <img class="software-icon__circle" src={card.iconDefault} alt="" width="48" height="48" />
                      <img
                        class="software-icon__glyph software-icon__glyph--default"
                        src={card.iconGlyphDefault}
                        alt=""
                        width="24"
                        height="22.6356"
                      />
                    </span>
                    <span class="hero-audience-card__icon-img hero-audience-card__icon-img--hover">
                      <img class="software-icon__circle" src={card.iconHover} alt="" width="30" height="30" />
                      <img
                        class="software-icon__glyph software-icon__glyph--hover"
                        src={card.iconGlyphHover}
                        alt=""
                        width="15.375"
                        height="14.5222"
                      />
                    </span>
                  </>
                ) : (
                  <>
                    <img
                      class="hero-audience-card__icon-img hero-audience-card__icon-img--default"
                      src={card.iconDefault}
                      alt=""
                      decoding="async"
                    />
                    <img
                      class="hero-audience-card__icon-img hero-audience-card__icon-img--hover"
                      src={card.iconHover}
                      alt=""
                      decoding="async"
                    />
                  </>
                )
              }
            </span>
          </button>
        ))
      }
    </div>

    <img
      src="/images/dashboard-preview-image0_2022_2173.webp"
      alt="Pixeldesk dashboard showing project summaries, status, and team widgets"
      width="931"
      height="543"
      class="hero-dashboard-preview"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>

<style is:global>
  .hero-part {
    position: absolute;
    opacity: 0;
    transform: translate3d(var(--from-x, 0), var(--from-y, 0), 0);
    transition:
      opacity 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      transform 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
    will-change: transform, opacity;
    display: block;
    height: auto;
    object-fit: contain;
  }

  .hero-visual.is-ready .hero-part {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  /* PD-Website-UI-2026 Home hero — layout.json (499×455.5) */
  .hero-part--purple-b {
    top: 8.46%;
    left: 0;
    z-index: 0;
    width: 71.68%;
    height: 54.88%;
  }

  .hero-part--purple-a {
    top: 37.96%;
    left: 28.32%;
    z-index: 0;
    width: 71.68%;
    height: 54.88%;
  }

  .hero-part--map {
    top: 54.23%;
    left: 6.21%;
    z-index: 2;
    width: 31.29%;
    height: 26.25%;
  }

  .hero-part--people {
    top: 41.22%;
    left: 58.61%;
    z-index: 4;
    width: 34.06%;
    height: 31.57%;
  }

  .hero-part--today {
    top: 72.02%;
    left: 57.43%;
    z-index: 6;
    width: 36.63%;
    height: 27.98%;
  }

  .hero-part--project {
    top: 0;
    left: 22.38%;
    z-index: 7;
    width: 39.6%;
    height: 43.39%;
  }

  /* Figma 2022:1568, 2022:1596, 2022:2137 — 4/4/7.5 shadow at 15% black. */
  .hero-part--project,
  .hero-part--map,
  .hero-part--today {
    filter: drop-shadow(
      calc(4px * var(--pd-scale)) calc(4px * var(--pd-scale)) calc(7.5px * var(--pd-scale))
        rgba(0, 0, 0, 0.15)
    );
  }

  /* LCP hero card — visible while loading; no fade-in delay */
  .hero-part--lcp {
    opacity: 1;
  }

  .hero-visual.is-ready .hero-part--lcp {
    opacity: 1;
  }

  .hero-part--stars {
    top: 33.37%;
    left: 73.15%;
    z-index: 8;
    width: 14.21%;
    height: 2.61%;
  }

  .hero-part--folder {
    top: 43.47%;
    left: 13.83%;
    z-index: 9;
    width: 7.82%;
    height: 8.78%;
  }

  .hero-part--sprint {
    top: 82.33%;
    left: 20.24%;
    z-index: 9;
    width: 11.42%;
    height: 3.73%;
  }

  /* Figma Frame 923 label, slightly reduced for visual balance */
  .hero-audience__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 160px;
    height: 35px;
    margin: 0;
    border-radius: 100px;
    background: rgba(108, 65, 255, 0.11);
    color: var(--color-purple);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 500;
    line-height: 35px;
    white-space: nowrap;
    vertical-align: middle;
  }

  /* Figma Home — audience row: 174×174 cards, 12px gap (2197:343–373) */
  .hero-audience__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(12px * var(--pd-scale));
    width: 100%;
    max-width: calc(734px * var(--pd-scale));
    margin: calc(31px * var(--pd-scale)) auto 0;
  }

  /* image 1 (2022:2173): 191px below cards → visible top; SVG has 19px top bleed */
  .hero-dashboard-preview {
    display: block;
    width: 100%;
    max-width: 1163.75px;
    height: auto;
    margin: 238.75px auto 0;
    border-radius: calc(14px * var(--pd-scale));
    box-shadow:
      calc(6px * var(--pd-scale)) calc(6px * var(--pd-scale)) calc(25px * var(--pd-scale)) 0
      rgba(0, 0, 0, 0.1);
  }

  /* Figma 2197:251 — Default: #f0f0f0, 181×181, rx=10, p=15; Variant2 hover: #000945 + body */
  .hero-audience-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    box-sizing: border-box;
    width: 100%;
    aspect-ratio: 1;
    padding: calc(15px * var(--pd-scale));
    border: none;
    border-radius: calc(10px * var(--pd-scale));
    background: #f0f0f0;
    color: var(--color-purple);
    text-align: left;
    cursor: default;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .hero-audience-card__title {
    font-size: calc(20px * var(--pd-scale));
    font-weight: 600;
    line-height: calc(22px * var(--pd-scale));
    color: var(--color-purple);
    transition:
      color 0.2s ease,
      font-size 0.2s ease,
      line-height 0.2s ease;
  }

  .hero-audience-card__body {
    margin: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    font-size: calc(12px * var(--pd-scale));
    font-weight: 400;
    line-height: calc(15px * var(--pd-scale));
    color: #fff;
    transition:
      opacity 0.2s ease,
      max-height 0.2s ease;
  }

  .hero-audience-card__body--sm {
    font-size: calc(10px * var(--pd-scale));
    line-height: calc(12px * var(--pd-scale));
  }

  .hero-audience-card__icon {
    position: relative;
    flex-shrink: 0;
    width: calc(48px * var(--pd-scale));
    height: calc(48px * var(--pd-scale));
    transition:
      width 0.2s ease,
      height 0.2s ease;
  }

  .hero-audience-card__icon-img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s ease;
  }

  .hero-audience-card__icon-img--hover {
    opacity: 0;
  }

  .software-icon__circle,
  .software-icon__glyph {
    position: absolute;
    display: block;
    max-width: none;
  }

  .software-icon__circle {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Figma 2197:303 — 24×22.6356 export positioned in the 48×48 circle. */
  .software-icon__glyph--default {
    top: 26.4125%;
    left: 26.0417%;
    width: 50%;
    height: 47.1575%;
  }

  /* Figma 2197:311 — 15.375×14.5222 export positioned in the 30×30 circle. */
  .software-icon__glyph--hover {
    top: 25.7867%;
    left: 25.4167%;
    width: 51.25%;
    height: 48.4073%;
  }

  @media (hover: hover) {
    .hero-audience-card:hover,
    .hero-audience-card:focus-visible {
      background: var(--color-navy);
      color: #fff;
      outline: none;
    }

    .hero-audience-card:hover .hero-audience-card__title,
    .hero-audience-card:focus-visible .hero-audience-card__title {
      font-size: calc(15px * var(--pd-scale));
      line-height: calc(16px * var(--pd-scale));
      color: #fff;
    }

    .hero-audience-card:hover .hero-audience-card__body,
    .hero-audience-card:focus-visible .hero-audience-card__body {
      max-height: calc(85px * var(--pd-scale));
      opacity: 1;
    }

    .hero-audience-card:hover .hero-audience-card__icon,
    .hero-audience-card:focus-visible .hero-audience-card__icon {
      width: calc(30px * var(--pd-scale));
      height: calc(30px * var(--pd-scale));
    }

    .hero-audience-card:hover .hero-audience-card__icon-img--default,
    .hero-audience-card:focus-visible .hero-audience-card__icon-img--default {
      opacity: 0;
    }

    .hero-audience-card:hover .hero-audience-card__icon-img--hover,
    .hero-audience-card:focus-visible .hero-audience-card__icon-img--hover {
      opacity: 1;
    }
  }

  @media (min-width: 1024px) {
    .hero-audience__grid {
      display: flex;
      flex-wrap: nowrap;
      justify-content: center;
    }

    .hero-audience-card {
      width: calc(174px * var(--pd-scale));
      flex: 0 0 calc(174px * var(--pd-scale));
      aspect-ratio: 1;
    }
  }

  /* Left hero copy — Figma nodes 2022:1561–1564 @ --pd-scale (×1.25) */
  .hero-copy__title {
    max-width: 526.25px;
    font-size: clamp(32px, 9.5vw, 55px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
    color: #000945;
  }

  .hero-copy__br {
    display: none;
  }

  /* Keeps word spacing when line-break <br>s are hidden on phone */
  .hero-copy__join {
    display: inline;
  }

  @media (min-width: 640px) {
    .hero-copy__title {
      font-size: 55px;
      line-height: 60px;
    }

    .hero-copy__br {
      display: block;
    }

    .hero-copy__join {
      display: none;
    }
  }

  .hero-copy__body {
    margin-top: 23.75px;
    margin-left: 1.25px;
    max-width: 501.25px;
    font-size: 17.5px;
    font-weight: 300;
    line-height: 25px;
    color: #000945;
  }

  /* Frame 957: no fill, 1px #6c41ff stroke, radius 25, navy label */
  .hero-copy__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    margin-top: 41.25px;
    min-width: 163.75px;
    height: 42.5px;
    padding: 0 30px;
    border-radius: 31.25px;
    background: transparent;
    color: #000945;
    font-size: 17.5px;
    font-weight: 400;
    line-height: 17.5px;
    white-space: nowrap;
    border: 1.25px solid #6c41ff;
    transition: background 0.15s ease;
  }

  .hero-copy__cta:hover {
    background: rgba(108, 65, 255, 0.08);
  }

  @media (max-width: 1023px) {
    .pd-hero-gradient {
      padding-top: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-part {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }
</style>

<script>
  function playHeroVisual() {
    document.querySelectorAll('[data-hero-visual]').forEach((el) => {
      el.classList.remove('is-ready');
      void el.offsetWidth;
      requestAnimationFrame(() => el.classList.add('is-ready'));
    });
  }

  playHeroVisual();
  document.addEventListener('astro:page-load', playHeroVisual);
</script>
