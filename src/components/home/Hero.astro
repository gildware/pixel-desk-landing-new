---
const audiences = ['Design Studios', 'Corporates', 'Consultancies', 'IT companies'];
---

<section class="pd-hero-gradient relative overflow-hidden pb-10 pt-[175px] sm:pt-[200px]">
  <div class="pd-rail grid items-center gap-10 lg:grid-cols-[526.25px_1fr] lg:gap-16">
    <div class="pl-5 lg:pl-5">
      <h1 class="max-w-[526.25px] text-[50px] font-medium leading-[60px] tracking-tight text-navy sm:text-[60px] sm:leading-[65px]">
        Where projects get done — and <span class="text-purple">teams actually thrive.</span>
      </h1>
      <p class="mt-5 max-w-[501.25px] text-[20px] font-light leading-[31.25px] text-navy">
        Managing a project means juggling tasks, timelines, team wellbeing, and client expectations all at once.
        Pixeldesk brings every piece of that picture into a single, intelligent workspace — so nothing slips through
        the gaps and everyone always knows where things stand.
      </p>
      <a href="/pricing" class="pd-btn-primary mt-8">Start for free</a>
    </div>

    <div class="hero-visual relative mx-auto aspect-[499/486] w-full max-w-[650px]" data-hero-visual aria-label="Pixeldesk product preview">
      <div class="hero-decor hero-decor--purple-a" aria-hidden="true"></div>
      <div class="hero-decor hero-decor--purple-b" aria-hidden="true"></div>

      <img
        src="/images/figma/hero-parts/project.svg"
        alt=""
        width="228"
        height="228"
        class="hero-part hero-part--project"
        style="--from-x: 0px; --from-y: -37.5px; --delay: 120ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/folder.svg"
        alt=""
        width="83"
        height="84"
        class="hero-part hero-part--folder"
        style="--from-x: -25px; --from-y: 0px; --delay: 200ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/map.svg"
        alt=""
        width="187"
        height="150"
        class="hero-part hero-part--map"
        style="--from-x: -35px; --from-y: 12.5px; --delay: 260ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/stars.svg"
        alt=""
        width="71"
        height="12"
        class="hero-part hero-part--stars"
        style="--from-x: 0px; --from-y: -17.5px; --delay: 320ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/people.svg"
        alt=""
        width="171"
        height="145"
        class="hero-part hero-part--people"
        style="--from-x: 30px; --from-y: -5px; --delay: 380ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/today.svg"
        alt=""
        width="222"
        height="158"
        class="hero-part hero-part--today"
        style="--from-x: 30px; --from-y: 35px; --delay: 460ms;"
        loading="eager"
        decoding="async"
      />

      <img
        src="/images/figma/hero-parts/sprint.svg"
        alt="Sprint Plan"
        width="57"
        height="17"
        class="hero-part hero-part--sprint"
        style="--from-x: 0px; --from-y: 17.5px; --delay: 520ms;"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="pd-rail mt-14 text-center sm:mt-16">
    <p class="inline-flex rounded-full bg-[#6C41FF1C] px-3 py-1 text-[13.75px] font-medium text-purple">
      Useful tool for
    </p>
    <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-5">
      {
        audiences.map((name) => (
          <div class="hero-audience-card flex min-h-[100px] items-center justify-center rounded-xl bg-[#f3f4f6] px-4 py-8 text-center text-[17.5px] font-medium leading-snug text-navy sm:min-h-[112.5px] sm:py-10 sm:text-[18.75px]">
            {name}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style is:global>
  .hero-visual {
    --card-shadow: 5px 5px 18.75px rgba(0, 0, 0, 0.12);
  }

  .hero-part {
    position: absolute;
    opacity: 0;
    transform: translate3d(var(--from-x, 0), var(--from-y, 0), 0);
    transition:
      opacity 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      transform 1.35s cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
    will-change: transform, opacity;
  }

  .hero-visual.is-ready .hero-part {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .hero-decor {
    position: absolute;
    pointer-events: none;
  }

  .hero-decor--purple-a {
    top: 4%;
    left: 2%;
    z-index: 0;
    width: 78%;
    height: 62%;
    border-radius: 46% 54% 48% 52% / 52% 44% 56% 48%;
    background:
      radial-gradient(ellipse 70% 60% at 42% 45%, rgba(186, 168, 255, 0.85) 0%, rgba(186, 168, 255, 0.4) 42%, transparent 70%);
    filter: blur(1.25px);
  }

  .hero-decor--purple-b {
    right: -4%;
    bottom: 0;
    z-index: 0;
    width: 74%;
    height: 68%;
    border-radius: 54% 46% 42% 58% / 48% 56% 44% 52%;
    background:
      radial-gradient(ellipse 65% 55% at 58% 48%, rgba(108, 65, 255, 0.5) 0%, rgba(150, 120, 240, 0.28) 45%, transparent 72%);
    filter: blur(1.25px);
  }

  /* Positions mapped from Figma Group 643 (~499×486). Card SVG widths scaled for filter padding. */
  .hero-part--project {
    top: 0;
    left: 20%;
    z-index: 6;
    width: min(48%, 310px);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--folder {
    top: 42%;
    left: 9%;
    z-index: 7;
    width: 55px;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--map {
    top: 50%;
    left: 2%;
    z-index: 5;
    width: min(39%, 252px);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--stars {
    top: 28%;
    left: 70%;
    z-index: 4;
    width: min(16%, 115px);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--people {
    top: 30%;
    left: 56%;
    z-index: 3;
    width: min(40%, 250px);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--today {
    top: 64%;
    right: 0;
    bottom: auto;
    z-index: 6;
    width: min(46%, 296px);
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-part--sprint {
    top: 78%;
    left: 18%;
    bottom: auto;
    z-index: 8;
    width: 85px;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .hero-audience-card {
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      background-color 0.25s ease;
  }

  .hero-audience-card:hover {
    transform: translateY(-4px);
    background-color: #eceef1;
    box-shadow: 0 6px 16px rgba(0, 9, 69, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-part {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .hero-audience-card {
      transition: none;
    }

    .hero-audience-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>

<script>
  function playHeroVisual() {
    document.querySelectorAll('[data-hero-visual]').forEach((el) => {
      el.classList.remove('is-ready');
      void el.offsetWidth;
      requestAnimationFrame(() => el.classList.add('is-ready'));
    });
  }

  playHeroVisual();
  document.addEventListener('astro:page-load', playHeroVisual);
</script>
