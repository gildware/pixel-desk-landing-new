---
/**
 * Native sticky stack — peek model + Why exit-lock.
 * Step 1 via --card-pin-offset; finale = last card only (no empty runway).
 */
const steps = [
  {
    title: 'Set up your workspace',
    body: 'Add your first members, upload profiles, and get the team onto Pixeldesk in minutes.',
    image: '/images/getting-started/01-workspace.svg',
  },
  {
    title: 'Invite Members',
    body: 'Complete profiles, invite teammates, and get everyone logged into the workspace.',
    image: '/images/getting-started/02-members.svg',
  },
  {
    title: 'Setup Policies',
    body: 'Configure leave types and company policies once — then every team member follows the same rules.',
    image: '/images/getting-started/03-policies.svg',
  },
  {
    title: 'Invite your clients',
    body: 'Add client companies, contacts, and details so every project stays connected to the right people.',
    image: '/images/getting-started/04-clients.svg',
  },
  {
    title: 'Customize your dashboard',
    body: 'Arrange widgets for projects, tasks, and utilization so every role sees what matters first.',
    image: '/images/getting-started/05-dashboard.svg',
  },
  {
    title: 'Start your first project',
    body: 'Create a project with assignees, dates, clients, and files — then kick off delivery in minutes.',
    image: '/images/getting-started/06-project.svg',
  },
];

const leadSteps = steps.slice(0, -1);
const lastStep = steps[steps.length - 1];
const lastIndex = steps.length - 1;
---

<section class="bg-white pt-10 pb-2 sm:pt-14 sm:pb-4 lg:pb-[160px]">
  <div class="pd-rail">
    <div class="gs-stack" style={`--stack-count: ${steps.length};`} data-gs-stack>
      <div class="gs-stack__deck" data-gs-deck>
        <aside class="gs-stack__copy" data-gs-copy>
          <span class="gs-label">Getting started</span>
          <h2 class="mt-[26.25px] max-w-[587.5px] text-[50px] font-medium leading-[56.25px] text-navy">
            Up and running in minutes.
          </h2>
          <p class="mt-[26.25px] max-w-[465px] text-[17.5px] font-light leading-[23.75px] text-navy">
            No lengthy onboarding. No IT ticket. No consultant required. Pixeldesk is designed to be productive from day
            one.
          </p>

          <ol class="gs-steps" data-gs-steps>
            {
              steps.map((step, i) => (
                <li
                  class:list={['gs-step', i === 0 && 'is-active']}
                  data-gs-step
                  data-index={i}
                >
                  <span class="gs-step__marker" aria-hidden="true">
                    {i === 0 ? '1' : ''}
                  </span>
                  <div class="gs-step__content">
                    <h3 class="gs-step__title">{step.title}</h3>
                    <p class="gs-step__body">{step.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </aside>

        <div class="gs-stack__cards">
        {
          leadSteps.flatMap((step, i) => [
            <article
              class:list={['gs-stack__card', i === 0 && 'is-active']}
              style={`--i: ${i};`}
              data-gs-card
              data-index={i}
              aria-label={step.title}
            >
              <img
                src={step.image}
                alt={step.title}
                width="544"
                height="360"
                class="gs-stack__img"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </article>,
            <div class="gs-stack__spacer" aria-hidden="true" />,
          ])
        }

        <div class="gs-stack__finale" style={`--i: ${lastIndex};`} data-gs-finale>
          <article
            class="gs-stack__card gs-stack__card--finale"
            data-gs-card
            data-index={lastIndex}
            aria-label={lastStep.title}
          >
            <img
              src={lastStep.image}
              alt={lastStep.title}
              width="544"
              height="360"
              class="gs-stack__img"
              loading="lazy"
              decoding="async"
            />
          </article>
        </div>
        </div>

        <div class="gs-stack__spacer gs-stack__spacer--hold" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-gs-stack]');
    if (!root) return;

    const finale = root.querySelector('[data-gs-finale]');
    const copy = root.querySelector('[data-gs-copy]');
    const leadCards = [...root.querySelectorAll('.gs-stack__card')].filter(
      (c) => !c.classList.contains('gs-stack__card--finale'),
    );
    const allCards = [...root.querySelectorAll('[data-gs-card]')];
    const steps = [...root.querySelectorAll('[data-gs-step]')];
    if (!finale || !copy || !leadCards.length) return;

    const pinned = [copy, ...leadCards];
    let locking = false;
    let lastScrollY = window.scrollY;
    let offScreenAbove = false;

    const stickyTopFor = (el) => parseFloat(getComputedStyle(el).top) || 0;

    const stackedOffsetFor = (el, finaleStickyTop) =>
      parseFloat(getComputedStyle(el).top) - finaleStickyTop;

    const unlock = () => {
      if (!locking) return;
      locking = false;
      pinned.forEach((el) => {
        el.style.transform = '';
        el.style.position = '';
        el.style.left = '';
        el.style.width = '';
        el.style.top = '';
        el.style.right = '';
        el.style.margin = '';
        el.style.zIndex = '';
        el.style.maxHeight = '';
        el.style.visibility = '';
        el.classList.remove('is-exit-locked');
        delete el.dataset.exitOffset;
      });
      root.querySelectorAll('[data-gs-ghost]').forEach((g) => g.remove());
    };

    const lockElements = (useStackedOffsets, stickyTop, finaleTop) => {
      locking = true;

      pinned.forEach((el) => {
        const rect = el.getBoundingClientRect();
        el.dataset.exitOffset = useStackedOffsets
          ? String(stackedOffsetFor(el, stickyTop))
          : String(rect.top - finaleTop);
        el.classList.add('is-exit-locked');

        const ghost = document.createElement('div');
        ghost.setAttribute('data-gs-ghost', '');
        ghost.setAttribute('aria-hidden', 'true');
        ghost.style.height = `${el.offsetHeight}px`;
        ghost.style.width = `${el.offsetWidth}px`;
        ghost.style.pointerEvents = 'none';
        ghost.style.flexShrink = '0';
        const elStyle = getComputedStyle(el);
        ghost.style.marginTop = elStyle.marginTop;
        ghost.style.marginBottom = elStyle.marginBottom;
        if (el.classList.contains('gs-stack__copy')) {
          ghost.style.gridColumn = '1';
          ghost.style.gridRow = '1 / -1';
        }
        el.parentNode.insertBefore(ghost, el);

        el.style.position = 'fixed';
        el.style.left = `${rect.left}px`;
        el.style.width = `${rect.width}px`;
        el.style.top = `${rect.top}px`;
        el.style.right = 'auto';
        el.style.margin = '0';
        el.style.zIndex = el.classList.contains('gs-stack__copy')
          ? '30'
          : getComputedStyle(el).zIndex || '10';
        if (el.classList.contains('gs-stack__copy')) {
          el.style.maxHeight = `${rect.height}px`;
        }
      });
    };

    const syncLockedPositions = (finaleTop) => {
      pinned.forEach((el) => {
        const offset = parseFloat(el.dataset.exitOffset || '0');
        el.style.top = `${finaleTop + offset}px`;
      });
    };

    // Align card 0 with step 1.
    const syncStackLayout = () => {
      const step0 = root.querySelector('[data-gs-step]');
      if (!step0 || window.matchMedia('(max-width: 1023px)').matches) {
        root.style.removeProperty('--card-pin-offset');
        return;
      }
      const offset = Math.max(
        0,
        Math.round(step0.getBoundingClientRect().top - copy.getBoundingClientRect().top),
      );
      root.style.setProperty('--card-pin-offset', `${offset}px`);
    };

    const syncActiveStep = () => {
      let active = 0;
      allCards.forEach((card, i) => {
        if (card.classList.contains('gs-stack__card--finale')) {
          if (finale.getBoundingClientRect().top <= stickyTopFor(finale) + 1) active = i;
          return;
        }
        if (card.getBoundingClientRect().top <= stickyTopFor(card) + 1) active = i;
      });
      allCards.forEach((card, i) => {
        card.classList.toggle('is-active', i === active);
      });
      steps.forEach((step, i) => {
        const on = i === active;
        step.classList.toggle('is-active', on);
        const marker = step.querySelector('.gs-step__marker');
        if (marker) marker.textContent = on ? String(i + 1) : '';
      });
    };

    const updateExitLock = () => {
      if (window.matchMedia('(max-width: 1278.75px)').matches) {
        unlock();
        return;
      }

      const rootBox = root.getBoundingClientRect();
      const finaleTop = finale.getBoundingClientRect().top;
      const stickyTop = parseFloat(getComputedStyle(finale).top) || 0;
      const delta = window.scrollY - lastScrollY;
      const scrollingUp = delta < -1;

      if (rootBox.bottom < 0) {
        offScreenAbove = true;
        unlock();
        return;
      }

      if (rootBox.top > window.innerHeight) {
        offScreenAbove = false;
        unlock();
        return;
      }

      const exitThreshold = stickyTop - 0.5;
      const reenterThreshold = stickyTop + 2;
      // GS pins lower than Why — require clearly past pin before exit-lock (avoids jump at stack).
      const exiting = locking
        ? finaleTop < reenterThreshold
        : finaleTop < exitThreshold && finaleTop < stickyTop - 15;
      const enteringFromAbove =
        scrollingUp && offScreenAbove && rootBox.bottom > 0 && rootBox.top < 0;

      if (locking && scrollingUp && finaleTop >= exitThreshold) {
        unlock();
        offScreenAbove = false;
        return;
      }

      const shouldLock = exiting || enteringFromAbove || (locking && scrollingUp);
      if (!shouldLock) {
        if (!enteringFromAbove) offScreenAbove = false;
        unlock();
        return;
      }

      if (!locking) {
        lockElements(enteringFromAbove, stickyTop, finaleTop);
      }

      syncLockedPositions(finaleTop);
    };

    const update = () => {
      syncActiveStep();
      updateExitLock();
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
          lastScrollY = window.scrollY;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', () => {
      unlock();
      syncStackLayout();
      update();
    });
    window.visualViewport?.addEventListener('resize', () => {
      unlock();
      syncStackLayout();
      update();
    });
    syncStackLayout();
    update();
  })();
</script>

<style>
  .gs-label {
    display: inline-flex;
    align-items: center;
    height: 37.5px;
    padding: 6.25px 18.75px;
    border-radius: 50px;
    border: none;
    background: rgba(108, 65, 255, 0.12);
    color: #6c41ff;
    font-size: 17.5px;
    font-weight: 500;
    line-height: 31.25px;
  }

  .gs-stack {
    --stack-peek: 0px;
    --stack-gap: 1.5rem;
    --card-h: 397.5px;
    --header-h: 1.25rem;
    --pin-top: calc(var(--header-h) + 0.5rem);
    --card-pin-offset: 0px;
    --card-pin-top: calc(var(--pin-top) + var(--card-pin-offset));
    --slot-run: 60vh;
    position: relative;
    width: 100%;
    overflow-x: clip;
    isolation: isolate;
    z-index: 0;
  }

  .gs-stack__deck {
    position: relative;
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .gs-stack__copy {
    position: sticky;
    top: var(--pin-top);
    z-index: 2;
    align-self: start;
    margin-bottom: 1.5rem;
    max-height: none;
    overflow: visible;
  }

  .gs-stack__copy.is-exit-locked {
    z-index: 30;
    background: #fff;
  }

  .gs-stack__card {
    position: sticky;
    top: calc(var(--card-pin-top) + var(--i) * var(--stack-peek));
    z-index: calc(10 + var(--i));
    height: var(--card-h);
    margin: 0;
    overflow: hidden;
    border-radius: 17.5px;
    border: 1.25px solid #e2e2e2;
    background: #fff;
    box-shadow: none;
  }

  .gs-stack__card.is-active {
    box-shadow: 7.5px 7.5px 31.25px rgba(0, 0, 0, 0.08);
  }

  /* Push card 0 down to step 1; sticky base matches --card-pin-top */
  .gs-stack__card[data-index='0'] {
    margin-top: var(--card-pin-offset);
  }

  .gs-stack__cards {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .gs-stack__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      transparent 55%,
      rgba(255, 255, 255, 0.55) 78%,
      #fff 100%
    );
  }

  .gs-stack__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: left top;
    background: #fff;
  }

  .gs-stack__spacer:not(.gs-stack__spacer--hold) {
    /* Spread step-offset scroll evenly — avoids a lump/jump on the last pin */
    height: calc(var(--slot-run) + var(--card-pin-offset) / (var(--stack-count) - 1));
    flex-shrink: 0;
    pointer-events: none;
  }

  .gs-stack__spacer--hold {
    height: 12vh;
    flex-shrink: 0;
    pointer-events: none;
  }

  /* Pull each card / finale up out of its scroll slot — same formula as Why stack. */
  .gs-stack__spacer:not(.gs-stack__spacer--hold) + .gs-stack__card,
  .gs-stack__spacer:not(.gs-stack__spacer--hold) + .gs-stack__finale {
    margin-top: calc(-1 * var(--slot-run) + var(--stack-gap));
  }

  .gs-stack__finale {
    position: sticky;
    top: calc(var(--card-pin-top) + var(--i) * var(--stack-peek));
    z-index: calc(10 + var(--i));
  }

  .gs-stack__finale .gs-stack__card {
    position: relative !important;
    top: auto !important;
    z-index: 1;
  }

  /* Timeline — in-flow rail (matches design: outlined active ring + dots) */
  .gs-steps {
    --rail-size: 36.25px;
    --dot-size: 12.5px;
    --rail-gap: 11.25px;
    --rail-pad: 7.5px;
    position: relative;
    margin: 83.75px 0 0;
    /* room for ring stroke + white halo so overflow never clips the "1" */
    padding: 5px 0 2.5px var(--rail-pad);
    list-style: none;
  }

  .gs-steps::before {
    content: '';
    position: absolute;
    left: calc(var(--rail-pad) + var(--rail-size) / 2);
    top: calc(5px + var(--rail-size) / 2);
    bottom: calc(2.5px + var(--rail-size) / 2);
    width: 1.25px;
    transform: translateX(-50%);
    background: #d9d9e3;
    pointer-events: none;
  }

  .gs-step {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-size) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    align-items: start;
    min-height: 73.75px;
  }

  .gs-step + .gs-step {
    margin-top: 27.5px;
  }

  .gs-step__marker {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    display: inline-flex;
    width: var(--rail-size);
    height: var(--rail-size);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2.5px solid transparent;
    background: #fff;
    color: #6c41ff;
    font-size: 16.25px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    text-align: center;
    -webkit-font-smoothing: antialiased;
    /* White halo clears the rail behind the marker */
    box-shadow: 0 0 0 5px #fff;
  }

  .gs-step:not(.is-active) .gs-step__marker {
    width: var(--dot-size);
    height: var(--dot-size);
    margin-top: calc((var(--rail-size) - var(--dot-size)) / 2);
    margin-left: calc((var(--rail-size) - var(--dot-size)) / 2);
    border: none;
    font-size: 0;
    color: transparent;
    background: #a8a8b8;
    box-shadow: 0 0 0 3.75px #fff;
  }

  .gs-step.is-active .gs-step__marker {
    width: var(--rail-size);
    height: var(--rail-size);
    margin: 0;
    border: 1.875px solid #6c41ff;
    background: #fff;
    color: #6c41ff;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    padding-top: 0.63px;
    box-shadow: 0 0 0 5px #fff;
  }

  .gs-step__content {
    min-width: 0;
    padding-top: 5px;
  }

  .gs-step__title {
    margin: 0;
    color: #444;
    font-size: 22.5px;
    font-weight: 600;
    line-height: 27.5px;
  }

  .gs-step__body {
    margin: 6.25px 0 0;
    max-width: 480px;
    color: #000945;
    font-size: 15px;
    font-weight: 400;
    line-height: 20px;
  }

  .gs-step.is-active .gs-step__title {
    color: #6c41ff;
  }

  @media (min-width: 1024px) {
    .gs-stack__deck {
      display: grid;
      grid-template-columns: minmax(0, 527.5px) minmax(0, 1fr);
      justify-content: space-between;
      column-gap: 87.5px;
      align-items: start;
    }

    .gs-stack__copy {
      grid-column: 1;
      grid-row-start: 1;
      grid-row-end: -1;
      width: 527.5px;
      margin-bottom: 0;
      z-index: 20;
      background: #fff;
    }

    .gs-stack__cards {
      grid-column: 2;
    }

    .gs-stack__spacer--hold {
      grid-column: 1 / -1;
    }

    .gs-stack__card,
    .gs-stack__finale .gs-stack__card {
      width: 100%;
      max-width: 680px;
    }
  }

  @media (max-width: 1023px) {
    .gs-stack {
      --card-h: 397.5px;
      --stack-peek: 10px;
      --header-h: 1rem;
      --pin-top: 1rem;
      --card-pin-offset: 0px;
      --slot-run: clamp(18rem, 50vh, 26rem);
    }

    .gs-stack__copy {
      position: relative;
      top: auto;
      max-height: none;
      overflow: visible;
    }

    .gs-stack__card[data-index='0'] {
      margin-top: 0;
    }

    .gs-stack__card {
      height: var(--card-h);
      overflow: hidden;
    }

    .gs-stack__img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: left top;
    }
  }

  @media (max-width: 639px) {
    .gs-stack {
      --stack-peek: 8px;
      --slot-run: clamp(16rem, 42vh, 22rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gs-stack__copy {
      position: relative;
      top: auto;
      max-height: none;
    }

    .gs-stack__deck {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .gs-stack__spacer,
    .gs-stack__spacer--hold {
      display: none;
    }

    .gs-stack__spacer:not(.gs-stack__spacer--hold) + .gs-stack__card,
    .gs-stack__spacer:not(.gs-stack__spacer--hold) + .gs-stack__finale {
      margin-top: 0;
    }

    .gs-stack__spacer:not(.gs-stack__spacer--hold) {
      height: var(--slot-run);
    }

    .gs-stack__card[data-index='0'] {
      margin-top: 0;
    }

    .gs-stack__card,
    .gs-stack__finale {
      position: relative;
      top: auto !important;
    }

    .gs-stack__card {
      height: auto;
      min-height: 275px;
    }

    .gs-stack__img {
      aspect-ratio: 544 / 360;
      height: auto;
      object-fit: contain;
      object-position: left top;
    }
  }
</style>
