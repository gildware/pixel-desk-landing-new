---
/**
 * LOCKED: native sticky stack — do not rewrite to a JS scene/pin.
 * Cards pin with peeks; last card + CTA are one sticky unit; a short
 * hold then exit-lock so copy + stack + CTA leave (and return) together.
 */
const stats = [
  {
    valueNum: '84',
    title: 'of businesses don’t communicate with clients through a PM tool',
    body: 'Email remains the most widely used tool for client communication at 59%, while only 16% of businesses use a project management tool to communicate with clients — meaning the vast majority of clients are getting project updates through a channel with no live data attached.',
    source: 'Source: Project.co Business Communication Statistics 2024',
    color: '#6c41ff',
  },
  {
    valueNum: '40',
    title: 'team members don’t fill timesheets accurately',
    body: 'Research shows 40% of employees either skip timesheets or fill them inaccurately — making project budgets and billing unreliable from day one.',
    source: 'Source: AffinityLive / Accelo via Shortlister',
    color: '#49455d',
  },
  {
    valueNum: '65',
    title: 'projects fail to meet their goals',
    body: 'Only 35% of projects worldwide finish on time, on budget, and with the required scope. The rest run over, get cut, or deliver less than promised.',
    source: 'Source: Standish Group CHAOS Report',
    color: '#c71671',
  },
  {
    valueNum: '42',
    title: 'PMs spend a full day manually compiling reports',
    body: '42% of project professionals spend one or more days every week just collating project status reports — almost entirely because their tools don’t connect.',
    source: 'Source: Wellingtone State of Project Management 2025',
    color: '#c88f15',
  },
  {
    valueNum: '89',
    title: 'of teams use more than one tool to manage work',
    body: 'With 89% of teams juggling multiple disconnected tools, context gets lost constantly — in emails, spreadsheets, chats, and file systems that never talk to each other.',
    source: 'Source: Smartsheet Limitations of Spreadsheets Report 2025',
    color: '#448dba',
  },
  {
    valueNum: '59',
    title: 'of businesses still communicate project updates to clients via email',
    body: '59% of businesses rely on email as their primary channel for client communication — meaning clients receive static, manually written updates rather than live, real-time visibility into their project’s actual status.',
    source: 'Source: Project.co Business Communication Statistics 2026',
    color: '#0a8080',
  },
];

const leadStats = stats.slice(0, -1);
const lastStat = stats[stats.length - 1];
const lastIndex = stats.length - 1;
---

<section class="why-exists pb-10 sm:pb-12 pt-12 lg:pt-[301.25px]">
  <div class="pd-rail">
    <div class="why-stack" style={`--stack-count: ${stats.length};`} data-why-stack>
      <div class="why-stack__deck" data-why-deck>
        <aside class="why-stack__copy">
          <span class="why-exists__label">Why Pixeldesk exists</span>
          <h2 class="why-exists__title">
            Most tools track work. <span class="why-exists__title-accent">Pixeldesk understands it.</span>
          </h2>
          <p class="why-exists__body">
            Project tools were built to manage tasks. But projects don’t fail because of tasks — they fail because of the
            gaps around them. The client who didn’t know. The budget that crept past. The team member who burned out
            quietly. The decision lost in a chat thread. Pixeldesk was built to close those gaps.
          </p>
        </aside>

        <div class="why-stack__cards">
          {
            leadStats.flatMap((stat, i) => [
              <article
                class="why-stack__card"
                style={`--i: ${i}; background-color: ${stat.color};`}
                aria-label={`${stat.valueNum}% ${stat.title}`}
              >
                <div class="why-card__layout">
                  <p class="why-card__value" aria-hidden="true">
                    <span class="why-card__value-num">{stat.valueNum}</span>
                    <span class="why-card__value-suffix">%</span>
                  </p>
                  <div class="why-card__content">
                    <h3 class="why-card__title">{stat.title}</h3>
                    <p class="why-card__body">{stat.body}</p>
                    <p class="why-card__source">{stat.source}</p>
                  </div>
                </div>
              </article>,
              <div class="why-stack__spacer" aria-hidden="true" />,
            ])
          }

          <!-- Last card + CTA: one unit. JS locks peeks/copy to this unit on exit. -->
          <div class="why-stack__finale" style={`--i: ${lastIndex};`} data-why-finale>
            <article
              class="why-stack__card why-stack__card--finale"
              style={`background-color: ${lastStat.color};`}
              aria-label={`${lastStat.valueNum}% ${lastStat.title}`}
            >
              <div class="why-card__layout">
                <p class="why-card__value" aria-hidden="true">
                  <span class="why-card__value-num">{lastStat.valueNum}</span>
                  <span class="why-card__value-suffix">%</span>
                </p>
                <div class="why-card__content">
                  <h3 class="why-card__title">{lastStat.title}</h3>
                  <p class="why-card__body">{lastStat.body}</p>
                  <p class="why-card__source">{lastStat.source}</p>
                </div>
              </div>
            </article>

            <div class="why-stack__cta">
              <div class="why-stack__cta-pill">
                <div class="why-stack__pill">
                  <img
                    src="/images/icons/portal-check.svg"
                    alt=""
                    width="42"
                    height="42"
                    class="why-stack__pill-icon"
                  />
                  <p class="why-stack__pill-text">
                    Pixeldesk gives every client a live portal — real-time project status, budget visibility, milestone
                    tracking, and direct feedback tools — so they never have to ask for an update again.
                  </p>
                </div>
              </div>

              <div class="why-stack__cta-panel">
                <div class="why-stack__navy">
                  <p class="why-stack__navy-text">
                    These aren’t edge cases. They’re the everyday reality of running a project without the right
                    infrastructure. Every one of these problems has a direct solution in Pixeldesk.
                  </p>
                </div>
                <a href="/features" class="why-stack__btn pd-btn-primary">
                  See how Pixeldesk fixes this&nbsp;→
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="why-stack__spacer why-stack__spacer--hold" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-why-stack]');
    if (!root) return;

    const finale = root.querySelector('[data-why-finale]');
    const copy = root.querySelector('.why-stack__copy');
    const leadCards = [...root.querySelectorAll('.why-stack__card')].filter(
      (c) => !c.classList.contains('why-stack__card--finale'),
    );
    if (!finale || !copy || !leadCards.length) return;

    const pinned = [copy, ...leadCards];
    let locking = false;
    let lastScrollY = window.scrollY;
    let offScreenAbove = false;

    const stackedOffsetFor = (el, finaleStickyTop) =>
      parseFloat(getComputedStyle(el).top) - finaleStickyTop;

    const unlock = () => {
      if (!locking) return;
      locking = false;
      pinned.forEach((el) => {
        el.style.transform = '';
        el.style.position = '';
        el.style.left = '';
        el.style.width = '';
        el.style.top = '';
        el.style.right = '';
        el.style.margin = '';
        el.style.zIndex = '';
        el.style.maxHeight = '';
        el.style.visibility = '';
        el.classList.remove('is-exit-locked');
        delete el.dataset.exitOffset;
      });
      root.querySelectorAll('[data-why-ghost]').forEach((g) => g.remove());
    };

    const lockElements = (useStackedOffsets, stickyTop, finaleTop) => {
      locking = true;

      pinned.forEach((el) => {
        const rect = el.getBoundingClientRect();
        el.dataset.exitOffset = useStackedOffsets
          ? String(stackedOffsetFor(el, stickyTop))
          : String(rect.top - finaleTop);
        el.classList.add('is-exit-locked');

        const ghost = document.createElement('div');
        ghost.setAttribute('data-why-ghost', '');
        ghost.setAttribute('aria-hidden', 'true');
        ghost.style.height = `${el.offsetHeight}px`;
        ghost.style.width = `${el.offsetWidth}px`;
        ghost.style.pointerEvents = 'none';
        ghost.style.flexShrink = '0';
        const elStyle = getComputedStyle(el);
        ghost.style.marginTop = elStyle.marginTop;
        ghost.style.marginBottom = elStyle.marginBottom;
        if (el.classList.contains('why-stack__copy')) {
          ghost.style.gridColumn = '1';
          ghost.style.gridRow = '1 / -1';
        }
        el.parentNode.insertBefore(ghost, el);

        el.style.position = 'fixed';
        el.style.left = `${rect.left}px`;
        el.style.width = `${rect.width}px`;
        el.style.top = `${rect.top}px`;
        el.style.right = 'auto';
        el.style.margin = '0';
        el.style.zIndex = el.classList.contains('why-stack__copy')
          ? '30'
          : getComputedStyle(el).zIndex || '10';
        if (el.classList.contains('why-stack__copy')) {
          el.style.maxHeight = `${rect.height}px`;
        }
      });
    };

    const syncLockedPositions = (finaleTop) => {
      pinned.forEach((el) => {
        const offset = parseFloat(el.dataset.exitOffset || '0');
        el.style.top = `${finaleTop + offset}px`;
      });
    };

    const updateExitLock = () => {
      if (window.matchMedia('(max-width: 1278.75px)').matches) {
        unlock();
        return;
      }

      const rootBox = root.getBoundingClientRect();
      const finaleTop = finale.getBoundingClientRect().top;
      const stickyTop = parseFloat(getComputedStyle(finale).top) || 0;
      const delta = window.scrollY - lastScrollY;
      const scrollingUp = delta < -1;

      if (rootBox.bottom < 0) {
        offScreenAbove = true;
        unlock();
        return;
      }

      if (rootBox.top > window.innerHeight) {
        offScreenAbove = false;
        unlock();
        return;
      }

      const exitThreshold = stickyTop - 0.5;
      const reenterThreshold = stickyTop + 2;
      const exiting = locking ? finaleTop < reenterThreshold : finaleTop < exitThreshold;
      const enteringFromAbove =
        scrollingUp && offScreenAbove && rootBox.bottom > 0 && rootBox.top < 0;

      if (locking && scrollingUp && finaleTop >= exitThreshold) {
        unlock();
        offScreenAbove = false;
        return;
      }

      const shouldLock = exiting || enteringFromAbove || (locking && scrollingUp);
      if (!shouldLock) {
        if (!enteringFromAbove) offScreenAbove = false;
        unlock();
        return;
      }

      if (!locking) {
        lockElements(enteringFromAbove, stickyTop, finaleTop);
      }

      syncLockedPositions(finaleTop);
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          updateExitLock();
          lastScrollY = window.scrollY;
        });
      },
      { passive: true },
    );
    window.addEventListener('resize', () => {
      unlock();
      updateExitLock();
    });
    updateExitLock();
  })();
</script>

<style>
  /* Frame 924 — section label */
  .why-exists__label {
    display: inline-flex;
    align-items: center;
    height: 37.5px;
    padding: 6.25px 18.75px;
    border-radius: 50px;
    background: rgba(108, 65, 255, 0.12);
    color: #6c41ff;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 500;
    line-height: 31.25px;
  }

  .why-exists__title {
    margin: 13.75px 0 0;
    max-width: 428.75px;
    color: #000945;
    font-family: var(--font-sans);
    font-size: 50px;
    font-weight: 500;
    line-height: 58.75px;
  }

  .why-exists__title-accent {
    color: #6c41ff;
  }

  .why-exists__body {
    margin: 48.75px 0 0;
    max-width: 370px;
    color: #000945;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 300;
    line-height: 25px;
  }

  .why-stack {
    --stack-peek: 17.5px;
    --stack-gap: 1.5rem;
    --card-h: 397.5px;
    --header-h: 1.25rem;
    --slot-run: 60vh;
    position: relative;
    width: 100%;
    overflow-x: clip;
    isolation: isolate;
    z-index: 0;
  }

  .why-stack__deck {
    position: relative;
    width: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .why-stack__copy {
    position: sticky;
    top: calc(var(--header-h) + 0.5rem);
    z-index: 2;
    align-self: start;
    margin-bottom: 1.5rem;
  }

  .why-stack__copy.is-exit-locked {
    z-index: 30;
    background: #fff;
  }

  .why-stack__card {
    position: sticky;
    top: calc(var(--header-h) + var(--i) * var(--stack-peek));
    z-index: calc(10 + var(--i));
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    height: var(--card-h);
    margin: 0;
    border-radius: 12.5px;
    padding: 2rem;
    box-shadow: 6.25px 6.25px 9.38px rgba(0, 0, 0, 0.16);
    color: #fff;
    opacity: 1;
    background-clip: padding-box;
  }

  .why-card__layout {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 1.25rem;
  }

  .why-card__value {
    margin: 0;
    flex-shrink: 0;
    color: #fff;
    letter-spacing: -1.25px;
    line-height: 1;
    white-space: nowrap;
  }

  .why-card__value-num {
    font-family: var(--font-sans);
    font-size: 70px;
    font-weight: 200;
    line-height: 47.5px;
  }

  .why-card__value-suffix {
    font-family: var(--font-sans);
    font-size: 32.5px;
    font-weight: 500;
    line-height: 47.5px;
  }

  .why-card__content {
    min-width: 0;
  }

  .why-card__title {
    margin: 0;
    max-width: 507.5px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 42.5px;
    font-weight: 300;
    line-height: 45px;
  }

  .why-card__body {
    margin: 1.25rem 0 0;
    max-width: 493.75px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 300;
    line-height: 27.5px;
  }

  .why-card__source {
    margin: 2rem 0 0;
    color: rgba(255, 255, 255, 0.5);
    font-family: var(--font-sans);
    font-size: 11.25px;
    font-weight: 300;
    line-height: 12.5px;
  }

  .why-stack__cards {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .why-stack__spacer {
    height: var(--slot-run);
    flex-shrink: 0;
    pointer-events: none;
  }

  .why-stack__spacer:not(.why-stack__spacer--hold) + .why-stack__card,
  .why-stack__spacer:not(.why-stack__spacer--hold) + .why-stack__finale {
    margin-top: calc(-1 * var(--slot-run) + var(--stack-gap));
  }

  .why-stack__spacer--hold {
    height: 12vh;
  }

  .why-stack__finale {
    position: sticky;
    top: calc(var(--header-h) + var(--i) * var(--stack-peek));
    z-index: calc(10 + var(--i));
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  .why-stack__finale .why-stack__card {
    position: relative !important;
    top: auto !important;
    z-index: auto;
    width: 100%;
    max-width: 100%;
  }

  .why-stack__cta {
    position: relative;
    margin-top: 1.25rem;
    padding-top: 2rem;
  }

  .why-stack__cta-pill {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 2;
    width: min(100%, 980px);
    transform: translateX(-50%);
  }

  .why-stack__pill {
    display: flex;
    align-items: center;
    gap: 12.5px;
    padding: 12.5px;
    border-radius: 50px;
    background: #fff;
    box-shadow: 6.25px 6.25px 9.38px rgba(0, 0, 0, 0.25);
  }

  .why-stack__pill-icon {
    width: 52.5px;
    height: 52.5px;
    flex-shrink: 0;
  }

  .why-stack__pill-text {
    margin: 0;
    color: #6c41ff;
    font-family: var(--font-sans);
    font-size: 18.75px;
    font-weight: 500;
    line-height: 26.25px;
    text-align: center;
  }

  .why-stack__cta-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .why-stack__navy {
    width: 100%;
    padding: 81.25px 40px 50px;
    border-radius: 17.5px;
    background: #000945;
    color: #fff;
    text-align: center;
  }

  .why-stack__navy-text {
    margin: 0 auto;
    max-width: 1092.5px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 25px;
    font-weight: 300;
    line-height: 32.5px;
  }

  .why-stack__btn {
    position: relative;
    z-index: 3;
    margin-top: -21.25px;
    min-width: 283.75px;
  }

  @media (min-width: 640px) {
    .why-stack__card {
      padding: 55px;
    }

    .why-card__layout {
      flex-direction: row;
      gap: 55px;
    }
  }

  @media (min-width: 1024px) {
    .why-stack__deck {
      display: grid;
      grid-template-columns: 428.75px minmax(0, 761.25px);
      justify-content: space-between;
      column-gap: 2rem;
      align-items: start;
    }

    .why-stack__copy {
      grid-column: 1;
      grid-row-start: 1;
      grid-row-end: -1;
      width: 428.75px;
      margin-bottom: 0;
      z-index: 20;
      background: #fff;
    }

    .why-stack__cards {
      grid-column: 2;
    }

    .why-stack__card,
    .why-stack__spacer:not(.why-stack__spacer--hold) {
      grid-column: auto;
    }

    .why-stack__spacer--hold {
      grid-column: 1 / -1;
    }

    .why-stack__card {
      width: 100%;
      max-width: 761.25px;
    }

    .why-stack__finale .why-stack__card {
      width: 100%;
      max-width: 761.25px;
    }

    .why-stack__cta {
      width: calc(100% + 428.75px + 2rem + 2 * var(--pd-page-gutter, 3.125rem));
      max-width: none;
      margin-left: calc(-1 * (428.75px + 2rem + var(--pd-page-gutter, 3.125rem)));
      margin-right: calc(-1 * var(--pd-page-gutter, 3.125rem));
      padding-inline: var(--pd-page-gutter, 3.125rem);
    }
  }

  @media (max-width: 1023px) {
    .why-stack {
      --card-h: min(375px, calc(100dvh - var(--header-h) - 10rem));
      --stack-peek: 12.5px;
      --header-h: 1rem;
      --slot-run: 65vh;
    }

    .why-stack__copy {
      position: relative;
      top: auto;
    }

    .why-stack__cta {
      width: 100%;
      margin-left: 0;
      margin-right: 0;
      padding-left: 0;
      padding-right: 0;
    }

    .why-stack__navy {
      padding: 64px 24px 40px;
    }

    .why-stack__navy-text {
      font-size: 22.5px;
      line-height: 32.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .why-stack__copy {
      position: relative;
      top: auto;
      grid-row: auto;
    }

    .why-stack__deck {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .why-stack__spacer {
      display: none;
    }

    .why-stack__spacer:not(.why-stack__spacer--hold) + .why-stack__card,
    .why-stack__spacer:not(.why-stack__spacer--hold) + .why-stack__finale {
      margin-top: 0;
    }

    .why-stack__card,
    .why-stack__finale {
      position: relative;
      top: auto !important;
    }

    .why-stack__card {
      height: auto;
      min-height: var(--card-h);
    }
  }
</style>
