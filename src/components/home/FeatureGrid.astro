---
const features = [
  {
    icon: '/images/figma/feature-workspace/dashboard.svg',
    iconWidth: 43.75,
    iconHeight: 43.75,
    label: 'Dashboard',
    title: 'Your data, your way.',
    body: 'Pixeldesk was built to answer all of these — from a single, customizable workspace that works for PMs, teams, and clients simultaneously.',
    tags: ['Real-time', 'Customizable', 'Role-based'],
  },
  {
    icon: '/images/figma/feature-workspace/projects.svg',
    iconWidth: 50.22,
    iconHeight: 42.72,
    label: 'Projects',
    title: 'Ship projects on time. Every time.',
    body: 'Transparent timeline views — from creation to delivery.',
    tags: ['Tasks', 'Milestones', 'Kanban'],
  },
  {
    icon: '/images/figma/feature-workspace/timesheets.svg',
    iconWidth: 45.21,
    iconHeight: 45.21,
    label: 'Timesheets',
    title: 'Log time. Bill accurately.',
    body: 'Task-linked time logging with manager approvals, billing reports, and excel exports.',
    tags: ['Billing', 'Approval flow'],
  },
  {
    icon: '/images/figma/feature-workspace/client-portal.svg',
    iconWidth: 51.25,
    iconHeight: 48.74,
    label: 'Client Portal',
    title: 'Give clients a seat — without losing control.',
    body: 'Live project status, budget view, live feedback, shareable link, and Excel export — all from one client login.',
    tags: ['Live status', 'Budget', 'Excel export'],
  },
  {
    icon: '/images/figma/feature-workspace/notice-board.svg',
    iconWidth: 48.2,
    iconHeight: 45,
    label: 'Notice Board',
    title: 'Important updates, impossible to miss.',
    body: 'Dashboard-pinned announcements for teams and clients — sprint alerts, holidays, policy updates.',
    tags: ['Team', 'Client-facing'],
  },
];
---

<section class="feature-workspace relative overflow-hidden">
  <div class="pd-rail relative z-[1]">
    <span class="feature-workspace__label">Everything your team needs</span>
    <h2 class="feature-workspace__title mt-[13.75px]">
      One workspace. Every role covered.
    </h2>
    <p class="feature-workspace__subtitle mt-[13.75px] max-w-[511.25px]">
      From sprint planning to birthday reminders — Pixeldesk handles the work around the work.
    </p>

    <div class="feature-workspace__grid mt-[72.5px]">
      {
        features.map((feature) => (
          <article class="feature-workspace__card">
            <div
              class="feature-workspace__icon"
              style={`width: ${feature.iconWidth}px; height: ${feature.iconHeight}px`}
            >
              <img
                src={feature.icon}
                alt=""
                width={feature.iconWidth}
                height={feature.iconHeight}
                class="block max-h-full max-w-full"
              />
            </div>
            <div class="feature-workspace__card-content">
              <span class="feature-workspace__chip-outline w-fit">{feature.label}</span>
              <h3 class="feature-workspace__card-title">{feature.title}</h3>
              <p class="feature-workspace__card-body">{feature.body}</p>
              <div class="feature-workspace__tags">
                {feature.tags.map((tag) => (
                  <span class="feature-workspace__tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }

      <a href="/features" class="feature-workspace__cta">
        <div class="feature-workspace__cta-bg-wrap" aria-hidden="true">
          <img
            src="/images/figma/feature-workspace/cta-bg-layer.png"
            alt=""
            class="feature-workspace__cta-bg"
            width="770"
            height="380"
          />
        </div>
        <div class="feature-workspace__cta-content">
          <p class="feature-workspace__cta-title">
            Many more features that make your project hassle free
          </p>
          <span class="feature-workspace__cta-link">
            See All Features
            <img
              src="/images/figma/feature-workspace/cta-arrow.svg"
              alt=""
              width="27.5"
              height="17.5"
              class="feature-workspace__cta-arrow"
            />
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .feature-workspace {
    /* Frame 2022:2223 — exported from Figma at 2× */
    position: relative;
    z-index: 2;
    isolation: isolate;
    padding-top: 146.5px;
    padding-bottom: 274px;
    background: #fff url('/images/figma/feature-workspace/section-bg.png') center top / cover no-repeat;
  }

  .feature-workspace__label {
    display: inline-flex;
    align-items: center;
    height: 37.5px;
    padding: 6.25px 18.75px;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.82);
    color: #6c41ff;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 500;
    line-height: 31.25px;
  }

  .feature-workspace__title {
    max-width: 862.5px;
    color: #000945;
    font-family: var(--font-sans);
    font-size: 50px;
    font-weight: 500;
    line-height: 58.75px;
    letter-spacing: 0;
  }

  .feature-workspace__subtitle {
    color: #000945;
    font-family: var(--font-sans);
    font-size: 17.5px;
    font-weight: 300;
    line-height: 23.75px;
  }

  .feature-workspace__grid {
    display: grid;
    column-gap: 33.75px;
    row-gap: 41.25px;
  }

  @media (min-width: 640px) {
    .feature-workspace__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .feature-workspace__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .feature-workspace__card {
    display: flex;
    min-height: 350px;
    flex-direction: column;
    justify-content: space-between;
    padding: 22.5px 26.25px;
    background: #fff;
    border: 0.625px solid #e2e2e2;
    border-radius: 18.75px;
    box-shadow: 6.25px 6.25px 9.375px rgba(0, 0, 0, 0.16);
  }

  .feature-workspace__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-start;
  }

  .feature-workspace__card-content {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .feature-workspace__chip-outline {
    display: inline-flex;
    align-items: center;
    height: 27.5px;
    padding: 6.25px 18.75px;
    border-radius: 50px;
    border: 0.625px solid #878787;
    color: #878787;
    font-family: var(--font-sans);
    font-size: 13.75px;
    font-weight: 600;
    line-height: 17.5px;
  }

  .feature-workspace__card-title {
    color: #000945;
    font-family: var(--font-sans);
    font-size: 27.5px;
    font-weight: 500;
    line-height: 30px;
    letter-spacing: 0;
  }

  .feature-workspace__card-body {
    color: #000945;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 300;
    line-height: 21.25px;
  }

  .feature-workspace__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .feature-workspace__tag {
    display: inline-flex;
    align-items: center;
    height: 22.5px;
    padding: 6.25px 12.5px;
    border-radius: 50px;
    background: rgba(108, 65, 255, 0.11);
    color: #6c41ff;
    font-family: var(--font-sans);
    font-size: 11.25px;
    font-weight: 600;
    line-height: 17.5px;
  }

  .feature-workspace__cta {
    position: relative;
    display: flex;
    min-height: 350px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    border: 0.625px solid #e2e2e2;
    border-radius: 18.75px;
    box-shadow: 6.25px 6.25px 18.75px rgba(0, 0, 0, 0.16);
    padding: 93.75px 38.75px;
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Frame 927 bg — exact Figma placement so pendant lines sit above title text */
  .feature-workspace__cta-bg-wrap {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 18.75px;
  }

  .feature-workspace__cta-bg {
    position: absolute;
    top: 0;
    left: -58.63%;
    width: 181.6%;
    height: 101.79%;
    max-width: none;
  }

  .feature-workspace__cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 21.25px;
  }

  .feature-workspace__cta:hover {
    transform: translateY(-2.5px);
    box-shadow: 6.25px 8.75px 22.5px rgba(0, 0, 0, 0.2);
  }

  .feature-workspace__cta-title {
    max-width: 258.75px;
    font-family: var(--font-sans);
    font-size: 27.5px;
    font-weight: 400;
    line-height: 28.75px;
    letter-spacing: 0;
  }

  .feature-workspace__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 21.25px;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 500;
    line-height: 30px;
  }

  .feature-workspace__cta-arrow {
    display: block;
    flex-shrink: 0;
  }
</style>
